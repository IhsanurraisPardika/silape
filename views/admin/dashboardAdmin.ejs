<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Admin</title>
  <link rel="icon" href="/images/sp.png" type="image/sp.png">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 antialiased">
  <div class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <%- include('../partials/sidebarAdmin') %>

      <!-- Main Content Area -->
      <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Header -->
        <%- include('../partials/header') %>

          <!-- Main Content -->
          <main class="flex-1 overflow-auto bg-gray-50">
            <div class="p-4 md:p-8 pb-24">
              <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-6">Dashboard Admin</h1>

              <!-- Summary Cards -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="bg-white rounded-lg shadow p-6 border-t-4 border-red-600 text-center">
                  <p class="text-lg md:text-xl font-bold text-black-500 mb-2">Total Kantor</p>
                  <p class="text-4xl md:text-5xl font-bold text-red-600 mb-4 font-mono">
                    <%= totalKantor %>
                  </p>
                  <p class="text-xs text-gray-400">Jumlah Kantor di Semen Padang</p>
                </div>

                <div class="bg-white rounded-lg shadow p-6 border-t-4 border-green-600 text-center">
                  <p class="text-lg md:text-xl font-bold text-black-500 mb-2">Sudah Dinilai</p>
                  <p class="text-4xl md:text-5xl font-bold text-green-600 mb-4 font-mono">
                    <%= sudahDinilai %>
                  </p>
                  <p class="text-xs text-gray-400">Total Kantor yang telah Selesai</p>
                </div>

                <div class="bg-white rounded-lg shadow p-6 border-t-4 border-blue-500 text-center">
                  <p class="text-xl font-bold text-black-500 mb-2">Sedang Proses</p>
                  <p class="text-5xl font-bold text-blue-500 mb-4 font-mono">
                    <%= sedangProses %>
                  </p>
                  <p class="text-xs text-gray-400">Total Kantor dalam status Draft/Proses</p>
                </div>

                <div class="bg-white rounded-lg shadow p-6 border-t-4 border-orange-500 text-center">
                  <p class="text-lg md:text-xl font-bold text-black-500 mb-2">Belum Diinput</p>
                  <p class="text-4xl md:text-5xl font-bold text-orange-500 mb-4 font-mono">
                    <%= belumDiinput %>
                  </p>
                  <p class="text-xs text-gray-400">Jumlah Kantor yang Belum ada data</p>
                </div>
              </div>

              <!-- Visualisasi Data -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <!-- Progress Chart -->
                <div class="bg-white rounded-lg shadow p-6">
                  <h2 class="text-xl font-semibold text-gray-800 mb-4">Progress Penilaian (%)</h2>
                  <div class="h-64 flex items-center justify-center">
                    <canvas id="progressChart"></canvas>
                  </div>
                </div>

                <!-- Team Performance Chart -->
                <div class="bg-white rounded-lg shadow p-6">
                  <h2 class="text-xl font-semibold text-gray-800 mb-4">Penyelesaian per Tim</h2>
                  <div class="h-64 flex items-center justify-center">
                    <canvas id="teamChart"></canvas>
                  </div>
                </div>
              </div>

              <!-- Riwayat Penilaian -->
              <div class="bg-white rounded-lg shadow p-6 mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Riwayat Penilaian</h2>

                <div class="space-y-3">
                  <% if (riwayatPenilaian.length===0) { %>
                    <div class="text-center py-8 text-gray-500 italic">
                      Belum ada aktivitas penilaian.
                    </div>
                    <% } else { %>
                      <% riwayatPenilaian.forEach(item=> { %>
                        <div
                          class="flex flex-col sm:flex-row sm:items-center justify-between border rounded-lg p-4 hover:bg-gray-50 gap-4 sm:gap-0">
                          <div class="flex items-center gap-4">
                            <% if (item.isSelesai) { %>
                              <div
                                class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center shrink-0">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                                </svg>
                              </div>
                              <% } else { %>
                                <div
                                  class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center shrink-0">
                                  <div class="w-3 h-3 bg-white rounded-full"></div>
                                </div>
                                <% } %>
                                  <div>
                                    <p class="font-semibold text-gray-800">
                                      <%= item.akun ? (item.akun.timKode || 'TIM' ) : 'TIM' %>
                                        <% if (item.anggota) { %> - <%= item.anggota.nama %>
                                            <% } %>
                                    </p>
                                    <p class="text-sm text-gray-500 uppercase">
                                      <%= item.kantor ? item.kantor.nama : 'KANTOR TIDAK DIKETAHUI' %>
                                    </p>
                                  </div>
                          </div>
                          <span
                            class="self-start sm:self-auto px-4 py-2 rounded-full <%= item.isSelesai ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700' %> text-sm font-medium">
                            <%= item.isSelesai ? 'Selesai' : 'Proses' %>
                          </span>
                        </div>
                        <% }); %>
                          <% } %>
                </div>
              </div>
            </div>
          </main>
      </div>
  </div>

  <!-- Hidden element to pass backend data to client-side scripts -->
  <div id="chartDataContainer" style="display: none;" data-source='<%- JSON.stringify(chartData) %>'></div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    const chartData = JSON.parse(document.getElementById('chartDataContainer').getAttribute('data-source'));
    console.log("Dashboard Chart Data:", chartData);

    // Progress Chart
    const ctxProgress = document.getElementById('progressChart').getContext('2d');
    new Chart(ctxProgress, {
      type: 'doughnut',
      data: {
        labels: ['Selesai', 'Sedang Proses', 'Belum Diinput'],
        datasets: [{
          data: [chartData.sudahDinilai, chartData.sedangProses, chartData.belumDiinput],
          backgroundColor: ['#16a34a', '#3b82f6', '#f97316'],
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom'
          }
        }
      }
    });

    // Team Chart
    const labelsTim = chartData.dataTim.map(d => d.tim);
    const dataSelesai = chartData.dataTim.map(d => d.selesai);
    const dataRataRata = chartData.dataTim.map(d => d.rataRata);

    const ctxTeam = document.getElementById('teamChart').getContext('2d');
    new Chart(ctxTeam, {
      type: 'bar',
      data: {
        labels: labelsTim,
        datasets: [
          {
            label: 'Kantor Selesai',
            data: dataSelesai,
            backgroundColor: '#dc2626',
            borderRadius: 5,
            yAxisID: 'y'
          },
          {
            label: 'Rata-rata Skor',
            data: dataRataRata,
            backgroundColor: '#3b82f6',
            borderRadius: 5,
            yAxisID: 'y1'
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: {
            type: 'linear',
            display: true,
            position: 'left',
            title: {
              display: true,
              text: 'Jumlah Kantor'
            },
            beginAtZero: true,
            ticks: {
              stepSize: 1
            }
          },
          y1: {
            type: 'linear',
            display: true,
            position: 'right',
            title: {
              display: true,
              text: 'Rata-rata Skor'
            },
            grid: {
              drawOnChartArea: false
            },
            beginAtZero: true,
            max: 100
          }
        },
        plugins: {
          legend: {
            position: 'bottom'
          }
        }
      }
    });
  </script>
</body>

</html>