<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Admin</title>
  <link rel="icon" href="/images/sp.png" type="image/sp.png">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 antialiased">
  <div class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <%- include('../partials/sidebarAdmin') %>

      <!-- Main Content Area -->
      <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Header -->
        <%- include('../partials/headerAdmin') %>

          <!-- Main Content -->
          <main class="flex-1 overflow-auto bg-gray-50">
            <div class="p-4 md:p-8 pb-24">
              <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-6">Dashboard Admin</h1>

              <!-- Summary Cards -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="bg-white rounded-lg shadow p-6 border-t-4 border-red-600 text-center">
                  <p class="text-lg md:text-xl font-bold text-black-500 mb-2">Total Kantor</p>
                  <p class="text-4xl md:text-5xl font-bold text-red-600 mb-4 font-mono">
                    <%= totalKantor %>
                  </p>
                  <p class="text-xs text-gray-400">Jumlah Kantor di Semen Padang</p>
                </div>

                <div class="bg-white rounded-lg shadow p-6 border-t-4 border-green-600 text-center">
                  <p class="text-lg md:text-xl font-bold text-black-500 mb-2">Sudah Dinilai</p>
                  <p class="text-4xl md:text-5xl font-bold text-green-600 mb-4 font-mono">
                    <%= sudahDinilai %>
                  </p>
                  <p class="text-xs text-gray-400">Total Kantor yang telah Selesai</p>
                </div>

                <div class="bg-white rounded-lg shadow p-6 border-t-4 border-blue-500 text-center">
                  <p class="text-xl font-bold text-black-500 mb-2">Sedang Proses</p>
                  <p class="text-5xl font-bold text-blue-500 mb-4 font-mono">
                    <%= sedangProses %>
                  </p>
                  <p class="text-xs text-gray-400">Total Kantor dalam status Draft/Proses</p>
                </div>

                <div class="bg-white rounded-lg shadow p-6 border-t-4 border-orange-500 text-center">
                  <p class="text-lg md:text-xl font-bold text-black-500 mb-2">Belum Diinput</p>
                  <p class="text-4xl md:text-5xl font-bold text-orange-500 mb-4 font-mono">
                    <%= belumDiinput %>
                  </p>
                  <p class="text-xs text-gray-400">Jumlah Kantor yang Belum ada data</p>
                </div>
              </div>

              <!-- Visualisasi Data -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <!-- Progress Chart -->
                <div class="bg-white rounded-lg shadow p-6">
                  <h2 class="text-xl font-semibold text-gray-800 mb-4">Progress Penilaian (%)</h2>
                  <div class="h-64 flex items-center justify-center">
                    <canvas id="progressChart"></canvas>
                  </div>
                </div>

                <!-- Team Performance Chart -->
                <div class="bg-white rounded-lg shadow p-6">
                  <h2 class="text-xl font-semibold text-gray-800 mb-4">Peringkat Rata-rata Tertinggi (Top 5)</h2>
                  <div class="space-y-3">
                    <% chartData.dataTim.forEach((team, index)=> {
                      let rankColor = 'bg-gray-100 text-gray-700';
                      if (index === 0) rankColor = 'bg-yellow-100 text-yellow-700';
                      if (index === 1) rankColor = 'bg-gray-200 text-gray-700';
                      if (index === 2) rankColor = 'bg-orange-100 text-orange-800';
                      %>
                      <div
                        class="flex flex-col sm:flex-row sm:items-center justify-between border rounded-lg p-3 hover:bg-gray-50 gap-2 sm:gap-0">
                        <div class="flex items-center gap-3">
                          <div
                            class="w-8 h-8 <%= rankColor %> rounded-full flex items-center justify-center font-bold text-sm shrink-0">
                            #<%= index + 1 %>
                          </div>
                          <div>
                            <p class="font-semibold text-gray-800 text-sm">
                              <%= team.kantor %>
                            </p>
                            <!-- Subtitle removed for cleaner look -->
                          </div>
                        </div>
                        <span
                          class="self-start sm:self-auto px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-bold">
                          Skor: <%= team.rataRata %>
                        </span>
                      </div>
                      <% }); %>
                        <% if (chartData.dataTim.length===0) { %>
                          <p class="text-center text-gray-500 italic text-sm py-4">Belum ada data penilaian.</p>
                          <% } %>
                  </div>
                </div>
              </div>

              <!-- Riwayat Approve Kantor -->
              <div class="bg-white rounded-lg shadow p-6 mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Riwayat Approve Kantor</h2>

                <div class="space-y-3">
                  <% if (riwayatPenilaian.length===0) { %>
                    <div class="text-center py-8 text-gray-500 italic">
                      Belum ada data yang disetujui (Approved).
                    </div>
                    <% } else { %>
                      <% riwayatPenilaian.forEach(item=> { %>
                        <div
                          class="flex flex-col sm:flex-row sm:items-center justify-between border rounded-lg p-4 hover:bg-gray-50 gap-4 sm:gap-0">
                          <div class="flex items-center gap-4">
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center shrink-0">
                              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M5 13l4 4L19 7"></path>
                              </svg>
                            </div>
                            <div>
                              <p class="font-semibold text-gray-800">
                                <%= item.kantor ? item.kantor.nama : 'KANTOR TIDAK DIKETAHUI' %>
                              </p>
                              <p class="text-sm text-gray-500">
                                Tim: <%= item.akun ? (item.akun.timKode || 'TIM' ) : 'TIM' %>
                              </p>
                            </div>
                          </div>
                          <div class="text-right">
                            <span
                              class="block px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold mb-1">
                              APPROVED
                            </span>
                            <span class="text-xs text-gray-500">
                              <%= item.tanggalApprove %>
                            </span>
                          </div>
                        </div>
                        <% }); %>
                          <% } %>
                </div>
              </div>
            </div>
          </main>
      </div>
  </div>

  <!-- Hidden element to pass backend data to client-side scripts -->
  <div id="chartDataContainer" style="display: none;" data-source='<%- JSON.stringify(chartData) %>'></div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
  <script>
    // Register the plugin globally
    Chart.register(ChartDataLabels);

    const chartData = JSON.parse(document.getElementById('chartDataContainer').getAttribute('data-source'));
    console.log("Dashboard Chart Data:", chartData);

    // Progress Chart
    const ctxProgress = document.getElementById('progressChart').getContext('2d');
    new Chart(ctxProgress, {
      type: 'doughnut',
      data: {
        labels: ['Selesai', 'Sedang Proses', 'Belum Diinput'],
        datasets: [{
          data: [chartData.sudahDinilai, chartData.sedangProses, chartData.belumDiinput],
          backgroundColor: ['#16a34a', '#3b82f6', '#f97316'],
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          datalabels: {
            color: '#fff',
            font: {
              weight: 'bold',
              size: 11
            },
            formatter: (value, ctx) => {
              const total = chartData.totalKantor || 1;
              const percentage = (value * 100 / total).toFixed(1) + "%";
              return value > 0 ? percentage : '';
            }
          },
          tooltip: {
            callbacks: {
              label: function (context) {
                let label = context.label || '';
                const total = chartData.totalKantor || 1;
                const percentage = (context.parsed * 100 / total).toFixed(1);
                return ` ${label}: ${context.parsed} (${percentage}%)`;
              }
            }
          },
          legend: {
            position: 'bottom'
          }
        }
      }
    });

    // Team Chart removed in favor of List View
  </script>
</body>

</html>