<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" href="/images/sp.png" type="image/sp.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lightbox -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/css/lightbox.min.css" rel="stylesheet" />
</head>

<body class="bg-gray-100 antialiased">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <%- include('../../partials/sidebarAdmin') %>

            <!-- Main Content Area -->
            <div class="flex-1 flex flex-col overflow-hidden">
                <!-- Header -->
                <%- include('../../partials/header') %>

                    <!-- Main Content -->
                    <main class="flex-1 overflow-auto bg-gray-50 p-4 md:p-8">
                        <div class="max-w-7xl mx-auto">
                            <!-- Breadcrumb & Header -->
                            <div class="mb-6 md:mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <div>
                                    <a href="/admin/kelola-foto<%= typeof periodeId !== 'undefined' ? '?periodeId=' + periodeId : '' %>"
                                        class="text-sm text-gray-500 hover:text-red-600 mb-2 inline-block">← Kembali ke
                                        Daftar</a>
                                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800">
                                        <%= kantor.nama %>
                                    </h1>
                                    <p class="text-sm md:text-base text-gray-600">Dokumentasi Foto Penilaian</p>
                                </div>

                                <% if (listFoto.length> 0) { %>
                                    <a href="/admin/kelola-foto/<%= kantor.id %>/pdf"
                                        class="w-full md:w-auto text-center justify-center flex items-center gap-2 bg-red-600 text-white px-5 py-2.5 rounded-lg hover:bg-red-700 transition shadow-lg active:scale-95">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4">
                                            </path>
                                        </svg>
                                        Unduh PDF
                                    </a>
                                    <% } %>
                            </div>

                            <% if (listFoto.length===0) { %>
                                <div class="bg-white rounded-xl shadow p-8 md:p-12 text-center">
                                    <p class="text-gray-500">Tidak ada foto untuk kantor ini.</p>
                                </div>
                                <% } else { %>
                                    <div
                                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6">
                                        <% listFoto.forEach((foto, i)=> { %>
                                            <div
                                                class="bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-md transition group">
                                                <!-- Image Wrap -->
                                                <div class="relative aspect-[4/3] bg-gray-100 overflow-hidden">
                                                    <a href="<%= foto.url %>" data-lightbox="gallery"
                                                        data-title="<%= foto.caption %>">
                                                        <img src="<%= foto.url %>" alt="Foto"
                                                            class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                                                    </a>
                                                    <div
                                                        class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4 pt-12">
                                                        <p class="text-white text-sm font-medium truncate">
                                                            <%= foto.kategori %>
                                                        </p>
                                                    </div>

                                                    <!-- Delete Button -->
                                                    <form action="/admin/kelola-foto/hapus" method="POST"
                                                        class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                                        <input type="hidden" name="fotoId" value="<%= foto.id %>">
                                                        <button type="submit"
                                                            class="btn-hapus-foto bg-red-600 hover:bg-red-700 text-white p-1.5 rounded-full shadow-md transition-colors"
                                                            title="Hapus Foto">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                                viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                                </path>
                                                            </svg>
                                                        </button>
                                                    </form>
                                                </div>
                                                <!-- Detail -->
                                                <div class="p-4">
                                                    <p class="text-xs text-gray-500 mb-1">Diinput oleh:</p>
                                                    <p class="text-sm font-semibold text-gray-800 mb-3">
                                                        <%= foto.penilai %>
                                                    </p>

                                                    <div
                                                        class="flex items-center gap-2 text-xs text-gray-400 border-t pt-3">
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor"
                                                            viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                                                            </path>
                                                        </svg>
                                                        <%= new Date(foto.tanggal).toLocaleString('id-ID',
                                                            {day: 'numeric' , month: 'short' , hour: '2-digit' ,
                                                            minute:'2-digit'}) %>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>
                                    <% } %>
                        </div>
                    </main>
            </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/js/lightbox.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Tangkap semua tombol hapus
        document.querySelectorAll('.btn-hapus-foto').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault(); // Stop form submit
                const form = this.closest('form');

                Swal.fire({
                    title: 'Apakah Anda yakin?',
                    text: "Foto yang dihapus tidak dapat dikembalikan!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Ya, hapus!',
                    cancelButtonText: 'Batal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });

        // Cek query params untuk SweetAlert success/error
        const urlParams = new URLSearchParams(window.location.search);
        const successMsg = urlParams.get('success');
        const errorMsg = urlParams.get('error');

        if (successMsg) {
            Swal.fire({
                icon: 'success',
                title: 'Berhasil',
                text: successMsg,
                timer: 2000,
                showConfirmButton: false
            }).then(() => {
                // Remove param from URL
                const url = new URL(window.location.href);
                url.searchParams.delete('success');
                window.history.replaceState({}, '', url);
            });
        }

        if (errorMsg) {
            Swal.fire({
                icon: 'error',
                title: 'Gagal',
                text: errorMsg,
            }).then(() => {
                // Remove param from URL
                const url = new URL(window.location.href);
                url.searchParams.delete('error');
                window.history.replaceState({}, '', url);
            });
        }
    </script>
</body>

</html>