<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" href="/images/sp.png" type="image/sp.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 antialiased">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <%- include('../../partials/sidebarAdmin') %>

            <!-- Main Content Area -->
            <div class="flex-1 flex flex-col overflow-hidden">
                <!-- Header -->
                <%- include('../../partials/header') %>

                    <!-- Main Content -->
                    <main class="flex-1 overflow-auto bg-gray-50 p-8">
                        <div class="max-w-7xl mx-auto">
                            <!-- Page Header -->
                            <div class="mb-8">
                                <h1 class="text-3xl font-bold text-gray-800">Kelola Foto Penilaian</h1>
                                <p class="text-gray-600 mt-2">Daftar kantor yang memiliki dokumentasi foto penilaian,
                                    dikelompokkan berdasarkan Tim.</p>
                            </div>

                            <% if (!periode) { %>
                                <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 mb-6"
                                    role="alert">
                                    <p class="font-bold">Perhatian</p>
                                    <p>Tidak ada periode penilaian yang aktif saat ini.</p>
                                </div>
                                <% } else if (Object.keys(data).length===0) { %>
                                    <div class="bg-white rounded-xl shadow-sm p-12 text-center">
                                        <div
                                            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                                </path>
                                            </svg>
                                        </div>
                                        <h3 class="text-lg font-medium text-gray-900">Belum ada data foto</h3>
                                        <p class="text-gray-500 mt-1">Belum ada penilaian yang menyertakan foto pada
                                            periode ini.</p>
                                    </div>
                                    <% } else { %>
                                        <div class="space-y-6">
                                            <% Object.keys(data).forEach(timKey=> { %>
                                                <div class="bg-white rounded-xl shadow overflow-hidden">
                                                    <!-- Header Tim -->
                                                    <div
                                                        class="bg-red-50 px-6 py-4 border-b border-red-100 flex justify-between items-center">
                                                        <h2 class="text-lg font-bold text-red-800">
                                                            <%= timKey %>
                                                        </h2>
                                                        <span
                                                            class="text-sm text-red-600 bg-red-100 px-3 py-1 rounded-full">
                                                            <%= data[timKey].length %> Kantor
                                                        </span>
                                                    </div>

                                                    <!-- List Kantor -->
                                                    <div class="divide-y divide-gray-100">
                                                        <% data[timKey].forEach(kantor=> { %>
                                                            <div
                                                                class="p-6 hover:bg-gray-50 transition flex items-center justify-between group">
                                                                <div>
                                                                    <h3 class="font-semibold text-gray-800 mb-1">
                                                                        <%= kantor.nama %>
                                                                    </h3>
                                                                    <div
                                                                        class="flex items-center gap-4 text-sm text-gray-500">
                                                                        <span class="flex items-center gap-1">
                                                                            <svg class="w-4 h-4" fill="none"
                                                                                stroke="currentColor"
                                                                                viewBox="0 0 24 24">
                                                                                <path stroke-linecap="round"
                                                                                    stroke-linejoin="round"
                                                                                    stroke-width="2"
                                                                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                                                                </path>
                                                                            </svg>
                                                                            <%= kantor.jumlahFoto %> Foto
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                                <a href="/admin/kelola-foto/<%= kantor.id %>"
                                                                    class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition shadow-sm">
                                                                    Lihat Foto
                                                                </a>
                                                            </div>
                                                            <% }); %>
                                                    </div>
                                                </div>
                                                <% }); %>
                                        </div>
                                        <% } %>

                        </div>
                    </main>
            </div>
    </div>
</body>

</html>