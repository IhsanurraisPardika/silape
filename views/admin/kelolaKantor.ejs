<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <title>
    <%= title %>
  </title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/images/sp.png" type="image/sp.png">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">

    <!-- SIDEBAR -->
    <%- include('../partials/sidebarAdmin') %>

      <!-- MAIN -->
      <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Header -->
        <%- include('../partials/headerAdmin') %>

          <main class="flex-1 overflow-auto bg-gray-50">

            <!-- CONTENT -->
            <section class="p-4 md:p-8 pb-24 space-y-6">

              <!-- BUTTONS -->
              <div class="flex flex-col sm:flex-row flex-wrap gap-3 items-start sm:items-center justify-between">
                <div class="flex gap-3 w-full sm:w-auto">
                  <!-- Optional Navigation link -->
                  <a href="/kelola-tim-penilai"
                    class="px-4 py-2 bg-white border rounded-lg shadow-sm hover:bg-gray-50 text-center flex-1 sm:flex-none">Kelola
                    Tim Penilai</a>
                  <button
                    class="px-4 py-2 bg-red-600 text-white rounded-lg shadow cursor-default text-center flex-1 sm:flex-none">Kelola
                    Kantor Tim</button>
                </div>

                <button id="btnTambahKantor"
                  class="w-full sm:w-auto px-4 py-2 bg-red-600 text-white rounded-lg shadow flex items-center justify-center gap-2 hover:bg-red-700 transition">
                  🏢 Tambah Kantor
                </button>
              </div>

              <% if (typeof error !=='undefined' && error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
                  <strong class="font-bold">Error!</strong>
                  <span class="block sm:inline">
                    <%= error %>
                  </span>
                </div>
                <% } %>

                  <!-- CARD CONTAINER -->
                  <div class="bg-white rounded-lg shadow-lg p-4 md:p-6 space-y-6">

                    <% if (dataTim && dataTim.length> 0) { %>
                      <% dataTim.forEach(tim=> { %>
                        <div class="tim-section border border-gray-100 rounded-lg overflow-hidden"
                          data-tim-nama="<%= tim.nama %>">
                          <div
                            class="bg-red-600 text-white px-4 py-3 font-semibold header-tim flex flex-col sm:flex-row justify-between items-start sm:items-center gap-1">
                            <span>
                              <%= tim.nama %>
                            </span>
                            <span class="text-sm font-normal span-jumlah bg-red-700 px-2 py-0.5 rounded opacity-90">
                              <%= tim.jumlah %> Kantor Penugasan
                            </span>
                          </div>

                          <div class="p-4 bg-gray-50">
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 list-kantor">
                              <% if (tim.kantor.length===0) { %>
                                <p class="text-gray-400 text-sm italic p-2 placeholder-empty col-span-full">Belum ada
                                  kantor ditugaskan.
                                </p>
                                <% } %>

                                  <% tim.kantor.forEach(k=> { %>
                                    <div
                                      class="bg-white border rounded-lg p-3 flex justify-between items-center shadow-sm hover:shadow-md transition">
                                      <div class="flex items-center gap-3 overflow-hidden">
                                        <span class="flex-shrink-0">🏢</span>
                                        <span class="font-medium truncate" title="<%= k.nama %>">
                                          <%= k.nama %>
                                        </span>
                                      </div>
                                      <button
                                        class="text-red-600 btn-delete hover:text-red-800 p-1 rounded hover:bg-red-50 transition ml-2"
                                        data-nama="<%= k.nama %>" title="Hapus">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20"
                                          fill="currentColor">
                                          <path fill-rule="evenodd"
                                            d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                                            clip-rule="evenodd" />
                                        </svg>
                                      </button>
                                    </div>
                                    <% }) %>
                            </div>
                          </div>
                        </div>
                        <% }) %>
                          <% } else { %>
                            <div class="text-center py-8 text-gray-500">
                              <p>Tidak ada data Tim Penilai (atau tidak ada Periode Aktif).</p>
                            </div>
                            <% } %>

                  </div>
            </section>
          </main>
          <!-- FOOTER -->
          <div class="mt-auto">
            <%- include('../partials/footer') %>
          </div>

          <!-- MODAL TAMBAH -->
          <div id="modalTambahKantor"
            class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">

            <div class="bg-white w-full max-w-md rounded-lg shadow-xl overflow-hidden transform transition-all">
              <div class="bg-red-600 text-white px-4 py-3 flex justify-between items-center">
                <h3 class="font-semibold text-lg">Tambah Kantor Baru</h3>
                <button id="closeModal" class="text-white hover:text-gray-200 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <form class="p-6 space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Pilih Tim</label>
                  <select name="timNama"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-red-500"
                    required>
                    <% if (dataTim && dataTim.length> 0) { %>
                      <% dataTim.forEach(tim=> { %>
                        <option value="<%= tim.nama %>">
                          <%= tim.nama %>
                        </option>
                        <% }) %>
                          <% } else { %>
                            <option disabled>Tidak ada tim tersedia (Pastikan ada Akun dengan TimKode)</option>
                            <% } %>
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Nama Kantor</label>
                  <input type="text" name="namaKantor" required placeholder="Contoh: KANTOR CABANG X"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-500">
                </div>

                <div class="flex justify-end gap-3 pt-2">
                  <button type="button" id="btnBatal"
                    class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Batal</button>
                  <button type="submit"
                    class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 shadow transition">Tambah</button>
                </div>
              </form>
            </div>
          </div>

          <!-- MODAL DELETE -->
          <div id="modalDelete"
            class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">

            <div class="bg-white w-full max-w-sm rounded-lg shadow-xl overflow-hidden transform transition-all">
              <div class="bg-red-600 text-white px-4 py-3 font-semibold text-lg">
                Konfirmasi Hapus
              </div>

              <div class="p-6 space-y-4">
                <p class="text-gray-600">
                  Yakin ingin menghapus kantor:
                  <br><span id="namaKantorDelete" class="font-bold text-gray-800 text-lg"></span>?
                </p>

                <div class="flex justify-end gap-3 pt-2">
                  <button id="batalDelete"
                    class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Batal</button>
                  <button id="confirmDelete"
                    class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 shadow transition">Ya,
                    Hapus</button>
                </div>
              </div>
            </div>
          </div>
          <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
          <script>
            const modalTambah = document.getElementById('modalTambahKantor');

            const formTambah = modalTambah.querySelector('form');
            // Gunakan selector by name agar lebih robust
            const selectTim = formTambah.querySelector('select[name="timNama"]');
            const inputNama = formTambah.querySelector('input[name="namaKantor"]');

            let targetElement = null;

            // ==============================
            // UPDATE JUMLAH KANTOR PER TIM
            // ==============================
            function updateJumlahKantor() {
              document.querySelectorAll('.header-tim').forEach(header => {
                const timWrapper = header.parentElement;
                const listKantor = timWrapper.querySelector('.list-kantor');

                if (!listKantor) return;

                const visibleKantor = [...listKantor.children].filter(el => !el.classList.contains('placeholder-empty'));
                const jumlah = visibleKantor.length;

                const spanJumlah = header.querySelector('.span-jumlah');
                if (spanJumlah) spanJumlah.textContent = `| ${jumlah} Kantor Penugasan`;
              });
            }

            // ==============================
            // BUKA & TUTUP MODAL TAMBAH
            // ==============================
            const btnTambah = document.getElementById('btnTambahKantor');
            if (btnTambah) {
              btnTambah.onclick = () => {
                modalTambah.classList.remove('hidden');
                modalTambah.classList.add('flex');
              };
            }

            const closeModalList = [document.getElementById('closeModal'), document.getElementById('btnBatal')];
            closeModalList.forEach(btn => {
              if (btn) {
                btn.onclick = () => {
                  modalTambah.classList.add('hidden');
                  modalTambah.classList.remove('flex');
                };
              }
            });


            // ==============================
            // TAMBAH KANTOR (AJAX)
            // ==============================
            formTambah.onsubmit = async (e) => {
              e.preventDefault();

              const timDipilih = selectTim.value;
              const namaKantorValue = inputNama.value.trim();
              if (!namaKantorValue) return;

              // Send to Backend
              try {
                const res = await fetch('/kelolaKantor/tambah', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ timNama: timDipilih, namaKantor: namaKantorValue })
                });
                const data = await res.json();

                if (data.success) {
                  // UI Update
                  addKantorToUI(timDipilih, namaKantorValue);

                  // Close Modal
                  modalTambah.classList.add('hidden');
                  modalTambah.classList.remove('flex');
                  inputNama.value = '';
                } else {
                  alert('Gagal menambah kantor: ' + (data.message || 'Error server'));
                }
              } catch (err) {
                console.error(err);
                alert('Terjadi kesalahan koneksi.');
              }
            };

            function addKantorToUI(timNama, namaKantor) {
              // Cari section tim
              const timSection = document.querySelector(`.tim-section[data-tim-nama="${timNama}"]`);
              if (!timSection) return;

              const listKantor = timSection.querySelector('.list-kantor');

              // Remove placeholder if exists
              const placeholder = listKantor.querySelector('.placeholder-empty');
              if (placeholder) placeholder.remove();

              const card = document.createElement('div');
              card.className = 'bg-white border rounded-lg p-3 flex justify-between items-center shadow-sm hover:shadow-md transition';
              card.innerHTML = `
      <div class="flex items-center gap-3">
        🏢 <span class="font-medium">${namaKantor}</span>
      </div>
      <button class="text-red-600 btn-delete hover:text-red-800 p-1 rounded hover:bg-red-50 transition ml-2" data-nama="${namaKantor}" title="Hapus">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd"
            d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
            clip-rule="evenodd" />
        </svg>
      </button>
    `;

              listKantor.appendChild(card);

              // Re-attach listener
              attachDeleteListener(card.querySelector('.btn-delete'));

              updateJumlahKantor();
            }

            // ==============================
            // DELETE
            // ==============================
            function attachDeleteListener(btn) {
              btn.onclick = () => {
                // Card kantor yang dirender server/dynamic sama-sama direct child dari .list-kantor
                targetElement = btn.closest('.list-kantor > div');
                const namaKantor = btn.dataset.nama;
                if (!namaKantor) return;

                Swal.fire({
                  title: 'Konfirmasi Hapus',
                  text: `Yakin ingin menghapus kantor: ${namaKantor}?`,
                  icon: 'warning',
                  showCancelButton: true,
                  confirmButtonText: 'Ya, Hapus',
                  cancelButtonText: 'Batal',
                  confirmButtonColor: '#dc2626'
                }).then(async (result) => {
                  if (!result.isConfirmed) return;

                  try {
                    const res = await fetch('/kelolaKantor/hapus', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ namaKantor })
                    });
                    const data = await res.json();

                    if (data.success) {
                      if (targetElement) {
                        const listParent = targetElement.parentElement;
                        targetElement.remove();
                        if (listParent && listParent.children.length === 0) {
                          // optional: placeholder
                        }
                      }
                      updateJumlahKantor();
                      Swal.fire({
                        title: 'Berhasil',
                        text: 'Kantor berhasil dihapus.',
                        icon: 'success',
                        confirmButtonColor: '#dc2626'
                      });
                    } else {
                      Swal.fire({
                        title: 'Gagal',
                        text: data.message || 'Gagal menghapus kantor.',
                        icon: 'error',
                        confirmButtonColor: '#dc2626'
                      });
                    }
                  } catch (err) {
                    console.error(err);
                    Swal.fire({
                      title: 'Gagal',
                      text: 'Gagal menghubungi server.',
                      icon: 'error',
                      confirmButtonColor: '#dc2626'
                    });
                  }
                });
              };
            }

            // Initial Attach
            document.querySelectorAll('.btn-delete').forEach(btn => attachDeleteListener(btn));

            // Modal delete custom tidak dipakai lagi (diganti SweetAlert2)

            // ==============================
            // INIT SAAT LOAD
            // ==============================
            // updateJumlahKantor(); // Not strictly needed since server renders correct count, but good for safety
          </script>
</body>

</html>