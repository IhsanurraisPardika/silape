<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <title>
        <%= title %>
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/sp.png" type="image/sp.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 antialiased">
    <div class="flex h-screen overflow-hidden">

        <!-- SIDEBAR -->
        <%- include('../partials/sidebarAdmin') %>

            <!-- MAIN -->
            <div class="flex-1 flex flex-col overflow-hidden">
                <!-- Header -->
                <%- include('../partials/headerAdmin') %>

                    <main class="flex-1 overflow-auto bg-gray-50">
                        <section class="p-4 md:p-8 pb-24">

                            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                                <h1 class="text-2xl md:text-3xl font-bold text-gray-800">Kelola Periode Penilaian</h1>
                                <button id="btnTambah"
                                    class="w-full md:w-auto bg-red-600 text-white px-6 py-2.5 rounded-lg shadow hover:bg-red-700 transition flex items-center justify-center gap-2">
                                    <span>+</span> Tambah Periode
                                </button>
                            </div>

                            <!-- TABLE / CARDS -->
                            <div class="bg-gray-100/50">
                                <!-- HEADER DESKTOP ONLY -->
                                <div
                                    class="hidden md:grid grid-cols-12 gap-4 bg-red-600 text-white font-semibold py-3 px-4 rounded-t-lg text-left">
                                    <div class="col-span-3">Nama Periode</div>
                                    <div class="col-span-2">Tahun</div>
                                    <div class="col-span-2">Semester</div>
                                    <div class="col-span-3">Status</div>
                                    <div class="col-span-2 text-right">Aksi</div>
                                </div>

                                <div class="space-y-4 md:space-y-2 md:bg-white md:rounded-b-lg md:shadow">
                                    <% if (periodes && periodes.length> 0) { %>
                                        <% periodes.forEach(p=> { %>
                                            <div
                                                class="bg-white p-4 md:py-4 md:px-4 rounded-xl md:rounded-none shadow-sm md:shadow-none border border-gray-200 md:border-0 md:border-b md:border-gray-200/50 flex flex-col md:grid md:grid-cols-12 gap-3 md:gap-4 items-start md:items-center">

                                                <!-- Nama Periode -->
                                                <div
                                                    class="md:col-span-3 font-semibold text-gray-800 w-full flex justify-between">
                                                    <span
                                                        class="md:hidden text-xs text-gray-500 uppercase font-bold">Periode</span>
                                                    <span>
                                                        <%= p.namaPeriode %>
                                                    </span>
                                                </div>

                                                <!-- Tahun -->
                                                <div class="md:col-span-2 text-gray-600 w-full flex justify-between">
                                                    <span
                                                        class="md:hidden text-xs text-gray-500 uppercase font-bold">Tahun</span>
                                                    <span>
                                                        <%= p.tahun %>
                                                    </span>
                                                </div>

                                                <!-- Semester -->
                                                <div class="md:col-span-2 text-gray-600 w-full flex justify-between">
                                                    <span
                                                        class="md:hidden text-xs text-gray-500 uppercase font-bold">Semester</span>
                                                    <span>
                                                        <%= p.semester %>
                                                    </span>
                                                </div>

                                                <!-- Status -->
                                                <div class="md:col-span-3 w-full flex justify-between items-center">
                                                    <span
                                                        class="md:hidden text-xs text-gray-500 uppercase font-bold">Status</span>
                                                    <% if (p.statusAktif) { %>
                                                        <span
                                                            class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                                            Aktif
                                                        </span>
                                                        <% } else { %>
                                                            <span
                                                                class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                                                                Non-Aktif
                                                            </span>
                                                            <% } %>
                                                </div>

                                                <!-- Aksi -->
                                                <div
                                                    class="md:col-span-2 w-full flex justify-end gap-2 border-t md:border-0 pt-3 md:pt-0 mt-1 md:mt-0">
                                                    <% if (!p.statusAktif) { %>
                                                        <button onclick="aktifkanPeriode('<%= p.id %>')"
                                                            class="text-green-600 hover:text-green-900 font-bold bg-green-50 md:bg-transparent px-3 py-1 rounded md:p-0">Aktifkan</button>
                                                        <% } %>
                                                            <button onclick="hapusPeriode('<%= p.id %>')"
                                                                class="text-red-600 hover:text-red-900 bg-red-50 md:bg-transparent px-3 py-1 rounded md:p-0">Hapus</button>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <div class="bg-white p-6 text-center text-gray-500 rounded-lg">
                                                        Belum ada data periode.
                                                    </div>
                                                    <% } %>
                                </div>
                            </div>

                        </section>
                    </main>

                    <div>
                        <%- include('../partials/footer') %>
                    </div>

                    <!-- MODAL TAMBAH -->
                    <div id="modalTambah"
                        class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
                        <div class="bg-white w-full max-w-sm rounded shadow-lg">
                            <div class="bg-red-600 text-white px-4 py-3 rounded-t font-bold flex justify-between">
                                <span>Tambah Periode Baru</span>
                                <button id="closeModal" class="text-xl">&times;</button>
                            </div>
                            <form id="formTambah" class="p-4 space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Tahun</label>
                                    <input type="number" name="tahun" value="2026"
                                        class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2"
                                        required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Semester</label>
                                    <select name="semester"
                                        class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2">
                                        <option value="1">1 (Ganjil)</option>
                                        <option value="2">2 (Genap)</option>
                                    </select>
                                </div>
                                <div class="flex justify-end pt-2">
                                    <button type="submit"
                                        class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">Simpan</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <script>
                        const modal = document.getElementById('modalTambah');
                        document.getElementById('btnTambah').onclick = () => {
                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                        };
                        document.getElementById('closeModal').onclick = () => {
                            modal.classList.add('hidden');
                            modal.classList.remove('flex');
                        };

                        document.getElementById('formTambah').onsubmit = async (e) => {
                            e.preventDefault();
                            const formData = new FormData(e.target);
                            const data = Object.fromEntries(formData.entries());

                            try {
                                const res = await fetch('/kelola-periode/tambah', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(data)
                                });
                                const result = await res.json();
                                if (result.success) {
                                    location.reload();
                                } else {
                                    alert(result.message);
                                }
                            } catch (err) {
                                console.error(err);
                                alert('Gagal menambah periode');
                            }
                        };

                        async function aktifkanPeriode(id) {
                            if (!confirm('Aktifkan periode ini? Periode lain akan dinonaktifkan.')) return;
                            try {
                                const res = await fetch(`/kelola-periode/aktifkan/${id}`, { method: 'POST' });
                                const result = await res.json();
                                if (result.success) location.reload();
                                else alert(result.message);
                            } catch (err) {
                                console.error(err);
                                alert('Gagal mengaktifkan');
                            }
                        }

                        async function hapusPeriode(id) {
                            if (!confirm('Yakin hapus? Data terkait (Penilaian dll) mungkin akan error.')) return;
                            try {
                                const res = await fetch(`/kelola-periode/hapus/${id}`, { method: 'DELETE' });
                                const result = await res.json();
                                if (result.success) location.reload();
                                else alert(result.message);
                            } catch (err) {
                                console.error(err);
                                alert('Gagal menghapus');
                            }
                        }
                    </script>

</body>

</html>