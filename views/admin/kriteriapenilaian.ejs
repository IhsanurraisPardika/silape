        function setActiveTab(pKey) {
            const btns = document.querySelectorAll('.tab-btn');
            btns.forEach(btn => {
                btn.classList.remove('tab-active', 'text-red-600');
                btn.classList.add('text-gray-500');
                btn.setAttribute('aria-selected', 'false');
            });

            const activeBtn = document.getElementById('btn-' + pKey);
            if (activeBtn) {
                activeBtn.classList.add('tab-active', 'text-red-600');
                activeBtn.classList.remove('text-gray-500');
                activeBtn.setAttribute('aria-selected', 'true');

                // Ensure active tab is visible on mobile
                activeBtn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            }
        }

        function switchTab(pKey) {
            setActiveTab(pKey);
            const items = kriteriaData[pKey] || [];
            renderMobileCards(items);
            renderTableRows(items);
        }

        function enableSwipeTabs() {
            let startX = 0;
            let startY = 0;
            let startTime = 0;

            const swipeTarget = document.querySelector('main');
            if (!swipeTarget) return;

            swipeTarget.addEventListener('touchstart', (e) => {
                if (!e.touches || e.touches.length !== 1) return;
                const t = e.touches[0];
                startX = t.clientX;
                startY = t.clientY;
                startTime = Date.now();
            }, { passive: true });

            swipeTarget.addEventListener('touchend', (e) => {
                if (!e.changedTouches || e.changedTouches.length !== 1) return;
                const t = e.changedTouches[0];
                const dx = t.clientX - startX;
                const dy = t.clientY - startY;
                const dt = Date.now() - startTime;

                // Only trigger on quick horizontal swipes
                if (dt > 600) return;
                if (Math.abs(dx) < 70) return;
                if (Math.abs(dx) < Math.abs(dy) * 1.5) return;

                const active = document.querySelector('.tab-btn[aria-selected="true"]');
                const activeId = active ? active.id.replace('btn-', '') : 'P1';
                const idx = TAB_KEYS.indexOf(activeId);
                if (idx === -1) return;

                if (dx < 0 && idx < TAB_KEYS.length - 1) switchTab(TAB_KEYS[idx + 1]);
                if (dx > 0 && idx > 0) switchTab(TAB_KEYS[idx - 1]);
            }, { passive: true });
        }

        window.onload = () => {
            switchTab('P1');
            enableSwipeTabs();
        };
    </script>
</body>

</html>