            body.innerHTML = '';
            if (!items || items.length === 0) return;

            items.forEach((item, index) => {
                const row = `
          <tr class="hover:bg-gray-50 transition-colors group align-top">
            <td class="px-4 py-4 text-center font-bold text-gray-500 group-hover:text-red-600 sticky left-0 bg-white group-hover:bg-gray-50 border-r border-gray-100">
              ${index + 1}
            </td>
            <td class="px-4 py-4 font-bold text-gray-800 sticky left-12 bg-white group-hover:bg-gray-50 border-r border-gray-100 shadow-[4px_0_5px_-2px_rgba(0,0,0,0.05)]">
              ${item.kriteria}
            </td>
            <td class="px-4 py-4 border-r border-gray-100 bg-red-50/30 text-gray-600 group-hover:bg-red-50/50">${item.r0_20}</td>
            <td class="px-4 py-4 border-r border-gray-100 bg-orange-50/30 text-gray-600 group-hover:bg-orange-50/50">${item.r21_40}</td>
            <td class="px-4 py-4 border-r border-gray-100 bg-yellow-50/30 text-gray-600 group-hover:bg-yellow-50/50">${item.r41_60}</td>
            <td class="px-4 py-4 border-r border-gray-100 bg-blue-50/30 text-gray-600 group-hover:bg-blue-50/50">${item.r61_80}</td>
            <td class="px-4 py-4 bg-green-50/30 text-gray-800 font-medium group-hover:bg-green-50/50 border-l-2 border-green-100">${item.r81_100}</td>
          </tr>
        `;
                body.innerHTML += row;
            });
        }

