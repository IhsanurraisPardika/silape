                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 1</label>
                        <input type="number" step="0.01" name="p1_k1" value="<%= existingWeights['p1_k1'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                      <div class="space-y-1">
