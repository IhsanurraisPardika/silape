<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <title>Rekap Penilaian</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/images/sp.png" type="image/sp.png">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 antialiased">
  <div class="flex h-screen overflow-hidden">

    <!-- SIDEBAR -->
    <%- include('../partials/sidebarAdmin') %>

      <!-- MAIN -->
      <div class="flex-1 flex flex-col overflow-hidden">
        <%- include('../partials/headerAdmin') %>

          <main class="flex-1 overflow-auto bg-gray-50">

            <!-- CONTENT -->
            <section class="p-4 md:p-8 pb-24">
              <div class="bg-white rounded-lg shadow p-6 max-w-6xl mx-auto">

                <h1 class="text-xl md:text-2xl font-bold text-gray-800 mb-2">Pengaturan Bobot Penilaian</h1>
                <p class="text-sm text-gray-500 mb-6 border-b border-gray-100 pb-4">
                  Atur bobot untuk setiap kriteria penilaian
                </p>


                <form action="/pengaturanBobot/simpan" method="POST" class="space-y-8">

                  <!-- P1 -->
                  <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
                    <h2 class="font-bold text-base mb-3 text-red-600 border-b border-red-100 pb-2">P1 - Pemilahan
