                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 3</label>
                        <input type="number" step="0.01" name="p1_k3" value="<%= existingWeights['p1_k3'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                    </div>
                  </div>

                  <!-- P2 -->
                  <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
                    <h2 class="font-bold text-base mb-3 text-red-600 border-b border-red-100 pb-2">P2 - Penataan
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 1</label>
                        <input type="number" step="0.01" name="p2_k1" value="<%= existingWeights['p2_k1'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 2</label>
                        <input type="number" step="0.01" name="p2_k2" value="<%= existingWeights['p2_k2'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 3</label>
                        <input type="number" step="0.01" name="p2_k3" value="<%= existingWeights['p2_k3'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 4</label>
                        <input type="number" step="0.01" name="p2_k4" value="<%= existingWeights['p2_k4'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                    </div>
                  </div>

                  <!-- P3 -->
                  <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
                    <h2 class="font-bold text-base mb-3 text-red-600 border-b border-red-100 pb-2">P3 - Pembersihan
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 1</label>
                        <input type="number" step="0.01" name="p3_k1" value="<%= existingWeights['p3_k1'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 2</label>
                        <input type="number" step="0.01" name="p3_k2" value="<%= existingWeights['p3_k2'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 3</label>
                        <input type="number" step="0.01" name="p3_k3" value="<%= existingWeights['p3_k3'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                    </div>
                  </div>

                  <!-- P4 -->
                  <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
                    <h2 class="font-bold text-base mb-3 text-red-600 border-b border-red-100 pb-2">P4 - Pemantapan
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 1</label>
                        <input type="number" step="0.01" name="p4_k1" value="<%= existingWeights['p4_k1'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 2</label>
                        <input type="number" step="0.01" name="p4_k2" value="<%= existingWeights['p4_k2'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
                      <div class="space-y-1">
                        <label class="text-xs font-semibold text-gray-500 uppercase">Kriteria 3</label>
                        <input type="number" step="0.01" name="p4_k3" value="<%= existingWeights['p4_k3'] || '' %>"
                          placeholder="0.00"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                      </div>
