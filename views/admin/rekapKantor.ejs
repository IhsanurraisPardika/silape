<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rekap Penilaian 5P</title>
  <link rel="icon" href="/images/sp.png">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 antialiased">
  <div class="flex h-screen overflow-hidden">
    <!-- SIDEBAR -->
    <%- include('../partials/sidebarAdmin') %>
      <!-- MAIN -->
      <div class="flex-1 flex flex-col overflow-hidden">
        <%- include('../partials/headerAdmin') %>

          <main class="flex-1 overflow-auto bg-gray-50 flex flex-col">
            <div class="p-4 md:p-8 pb-24 flex-grow">
              <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-6">Rekap Penilaian 5P</h1>

              <!-- FILTER & BUTTON -->
              <div
                class="bg-white p-4 lg:p-6 rounded-lg shadow mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                  <a href="/dashboardAdmin/rekapKantorAdmin"
                    class="text-center bg-red-600 text-white px-5 py-2 rounded-lg shadow transition hover:bg-red-700">
                    Rekap Kantor
                  </a>
                  <a href="/dashboardAdmin/rekapPenilaianAdmin"
                    class="text-center px-5 py-2 bg-white rounded-lg shadow hover:bg-gray-50 transition border border-gray-100">
                    Rekap Penilaian
                  </a>
                  <a href="/dashboardAdmin/rekapKriteriaAdmin"
                    class="text-center px-5 py-2 bg-white rounded-lg shadow hover:bg-gray-50 transition border border-gray-100">
                    Rekap Kriteria
                  </a>
                </div>

                <a href="/dashboardAdmin/downloadRekapKantor?kantorId=<%= selectedKantorId %>&periodeId=<%= periodeAktif ? periodeAktif.id : '' %>"
                  class="w-full md:w-auto text-center bg-green-600 text-white px-5 py-2 rounded-lg hover:bg-green-700 transition shadow block whitespace-nowrap">
                  Download Rekap
                </a>
              </div>

              <div class="mb-6">
                <form method="GET" action="/dashboardAdmin/rekapKantorAdmin"
                  class="flex flex-col md:flex-row md:items-center gap-2">
                  <label class="font-medium text-gray-700 whitespace-nowrap">Filter Periode :</label>
                  <select name="periodeId" onchange="this.form.submit()"
                    class="border border-gray-300 rounded-lg px-4 py-2 w-full md:w-56 focus:outline-none focus:ring-2 focus:ring-red-500 bg-white shadow-sm">
                    <% periodes.forEach(function(periode) { %>
                      <option value="<%= periode.id %>" <%=periodeAktif && periodeAktif.id===periode.id ? 'selected'
                        : '' %>>
                        <%= periode.namaPeriode %>
                      </option>
                      <% }); %>
                  </select>

                  <label class="font-medium text-gray-700 whitespace-nowrap">Filter Kantor :</label>
                  <select name="kantorId" onchange="this.form.submit()"
                    class="border border-gray-300 rounded-lg px-4 py-2 w-full md:w-72 focus:outline-none focus:ring-2 focus:ring-red-500 bg-white shadow-sm">
                    <option value="">-- Pilih Kantor --</option>
                    <% kantorList.forEach(function(kantor) { %>
                      <option value="<%= kantor.id %>" <%=selectedKantorId===kantor.id ? 'selected' : '' %>>
                        <%= kantor.nama %>
                      </option>
                      <% }); %>
                  </select>
                </form>
              </div>

              <!-- TABLE -->
              <div class="bg-white rounded-lg shadow overflow-hidden">
                <% if (selectedKantor && rekapData && Object.keys(rekapData.groupedData).length> 0) { %>
                  <div class="bg-red-700 text-white font-bold p-4 text-center md:text-left text-lg">
                    <%= selectedKantor.nama %>
                  </div>

                  <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-center text-sm min-w-[800px]">
                      <thead class="bg-gray-100">
                        <tr>
                          <th class="border p-3 font-semibold text-gray-600">Kriteria</th>
                          <th class="border p-3"></th>
                          <% headerColumns.forEach(function(nama) { %>
                            <th class="border p-3 font-semibold text-gray-600">
                              <%= nama %>
                            </th>
                            <% }); %>
                              <th class="border p-3 bg-cyan-100 font-semibold text-gray-700">Rata-rata</th>
                              <th class="border p-3 bg-green-100 font-semibold text-gray-700">Bobot</th>
                        </tr>
                      </thead>

                      <% Object.keys(rekapData.groupedData).forEach(function(pKey) { %>
                        <% const rows=rekapData.groupedData[pKey]; %>
                          <tbody class="divide-y divide-gray-200">
                            <tr class="bg-gray-50/50">
                              <td colspan="<%= 4 + headerColumns.length %>"
                                class="border p-3 text-left font-bold text-gray-800 bg-gray-50">
                                Penilaian <%= pKey %>
                              </td>
                            </tr>

                            <% rows.forEach(function(row) { %>
                              <!-- Row 1: Nilai -->
                              <tr class="hover:bg-gray-50 transition">
                                <td class="border p-3 font-medium align-top" rowspan="2">
                                  <%= row.kunci %>
                                </td>
                                <td class="border p-3 text-xs uppercase font-bold text-gray-500">Nilai</td>
                                <% headerColumns.forEach(function(nama) { %>
                                  <td class="border p-3 text-gray-700">
                                    <%= row.nilaiPerPenilai[nama] || '-' %>
                                  </td>
                                  <% }); %>
                                    <td class="border p-3 bg-cyan-50 font-bold" rowspan="2">
                                      <%= row.rataRata %>
                                    </td>
                                    <td class="border p-3 bg-green-50 font-bold" rowspan="2">
                                      <%= row.bobot %>
                                    </td>
                              </tr>
                              <!-- Row 2: Catatan -->
                              <tr class="hover:bg-gray-50 transition">
                                <td class="border p-3 font-semibold text-xs text-gray-500">Catatan</td>
                                <% headerColumns.forEach(function(nama) { %>
                                  <td class="border p-3 text-xs italic text-gray-500 max-w-[150px] truncate"
                                    title="<%= row.catatanPerPenilai[nama] %>">
                                    <%= row.catatanPerPenilai[nama] || '-' %>
                                  </td>
                                  <% }); %>
                              </tr>
                              <% }); %>

                                <tr class="bg-gray-100/50 font-semibold">
                                  <td colspan="<%= 2 + headerColumns.length %>" class="border p-3 text-right">
                                    Rata-rata <%= pKey %>
                                  </td>
                                  <td class="border p-3 bg-cyan-100">
                                    <%= rekapData.pAverages[pKey] %>
                                  </td>
                                  <td class="border p-3 bg-green-100 text-green-800">
                                    <%= rekapData.pTotalBobot[pKey] %>
                                  </td>
                                </tr>
                          </tbody>
                          <% }); %>

                    </table>
                  </div>

                  <div class="p-6 bg-gray-50 border-t border-gray-200">
                    <div
                      class="bg-white border border-gray-200 p-6 rounded-xl shadow-sm max-w-md ml-auto flex flex-col sm:flex-row items-center justify-between gap-4">
                      <span class="text-gray-600 font-medium">Nilai Akhir (Total Bobot):</span>
                      <span class="text-4xl font-bold text-green-600">
                        <%= rekapData.totalSkorAkhir %>
                      </span>
                    </div>
                  </div>

                  <% } else if (hasUnapprovedData) { %>
                    <div class="p-12 text-center flex flex-col items-center justify-center text-yellow-600">
                      <svg class="w-16 h-16 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <p class="text-lg font-bold">Data Menunggu Persetujuan Ketua Tim</p>
                      <p class="text-sm mt-2">Penilaian sudah diinputkan tetapi belum disetujui (Approved) oleh Ketua
                        Tim.</p>
                    </div>

                    <% } else { %>
                      <div class="p-12 text-center flex flex-col items-center justify-center text-gray-500">
                        <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                        <p class="text-lg font-medium">Silakan pilih kantor terlebih dahulu</p>
                        <p class="text-sm mt-2">Atau data penilaian kantor ini belum diinputkan sama sekali.</p>
                      </div>
                      <% } %>
              </div>
            </div>
            <div class="mt-auto">
              <%- include('../partials/footer') %>
            </div>
          </main>
      </div>
  </div>
</body>

</html>