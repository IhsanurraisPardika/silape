<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <title>Rekap Kriteria</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/images/sp.png" type="image/sp.png">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 antialiased">
  <div class="flex h-screen overflow-hidden">

    <!-- SIDEBAR -->
    <%- include('../partials/sidebarAdmin') %>

      <!-- MAIN -->
      <div class="flex-1 flex flex-col overflow-hidden">
        <%- include('../partials/headerAdmin') %>

          <main class="flex-1 overflow-auto bg-gray-50 flex flex-col">
            <div class="p-4 md:p-8 pb-24 flex-grow">
              <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-6">Rekap Penilaian 5P</h1>

              <!-- TAB -->
              <div class="flex flex-col sm:flex-row gap-3 mb-6">
                <a href="/dashboardAdmin/rekapKantorAdmin"
                  class="text-center px-5 py-2 bg-white rounded-lg shadow hover:bg-gray-50 transition border border-gray-100">
                  Rekap Kantor
                </a>

                <a href="/dashboardAdmin/rekapPenilaianAdmin"
                  class="text-center px-5 py-2 bg-white rounded-lg shadow hover:bg-gray-50 transition border border-gray-100">
                  Rekap Penilaian
                </a>

                <a href="/dashboardAdmin/rekapKriteriaAdmin"
                  class="text-center bg-red-600 text-white px-5 py-2 rounded-lg shadow transition hover:bg-red-700">
                  Rekap Kriteria
                </a>
              </div>

              <!-- FILTER & BUTTON -->
              <div class="bg-white p-4 lg:p-6 rounded-lg shadow mb-6 flex flex-col md:flex-row items-end gap-4">
                <div class="w-full md:w-auto">
                  <label class="block font-medium mb-1 text-sm text-gray-600">Tahun</label>
                  <select id="tahunFilter"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-red-500">
                    <% [...new Set(periodes.map(p=> p.tahun))].forEach(tahun => { %>
                      <option value="<%= tahun %>" <%=periodeAktif && periodeAktif.tahun===tahun ? 'selected' : '' %>>
                        <%= tahun %>
                      </option>
                      <% }) %>
                  </select>
                </div>

                <div class="w-full md:w-auto">
                  <label class="block font-medium mb-1 text-sm text-gray-600">Semester</label>
                  <select id="semesterFilter"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-red-500">
                    <option value="1" <%=periodeAktif && periodeAktif.semester===1 ? 'selected' : '' %>>1</option>
                    <option value="2" <%=periodeAktif && periodeAktif.semester===2 ? 'selected' : '' %>>2</option>
                  </select>
                </div>

                <div class="w-full md:w-auto md:ml-auto">
                  <a id="downloadBtn" href="/dashboardAdmin/downloadRekapKriteria"
                    class="block text-center w-full md:w-auto bg-green-600 text-white px-5 py-2 rounded-lg hover:bg-green-700 transition shadow">
                    Download Rekap
                  </a>
                </div>
              </div>

              <div id="periodesData" data-periodes="<%= JSON.stringify(periodes) %>" class="hidden"></div>

              <script>
                const periodes = JSON.parse(document.getElementById('periodesData').dataset.periodes);
                const tahunSelect = document.getElementById('tahunFilter');
                const semesterSelect = document.getElementById('semesterFilter');
                const downloadBtn = document.getElementById('downloadBtn');

                // Get current periodeId from URL
                const urlParams = new URLSearchParams(window.location.search);
                const currentPeriodeId = urlParams.get('periodeId');

                function updateSemesters(isInit = false) {
                  const selectedTahun = parseInt(tahunSelect.value);
                  const validSemesters = periodes
                    .filter(p => p.tahun === selectedTahun)
                    .map(p => p.semester)
                    .sort((a, b) => a - b);

                  // Keep current semester if it exists in new list
                  const currentVal = semesterSelect.value;
                  semesterSelect.innerHTML = '';

                  validSemesters.forEach(sms => {
                    const opt = document.createElement('option');
                    opt.value = sms;
                    opt.innerText = sms;
                    if (sms.toString() === currentVal) opt.selected = true;
                    semesterSelect.appendChild(opt);
                  });

                  if (!isInit) {
                    applyFilter();
                  } else {
                    updateDownloadLink();
                  }
                }

                function applyFilter() {
                  const thn = parseInt(tahunSelect.value);
                  const sms = parseInt(semesterSelect.value);
                  const p = periodes.find(item => item.tahun === thn && item.semester === sms);

                  if (p && p.id.toString() !== currentPeriodeId) {
                    window.location.href = `/dashboardAdmin/rekapKriteriaAdmin?periodeId=${p.id}`;
                  } else {
                    updateDownloadLink();
                  }
                }

                function updateDownloadLink() {
                  const thn = parseInt(tahunSelect.value);
                  const sms = parseInt(semesterSelect.value);
                  const p = periodes.find(item => item.tahun === thn && item.semester === sms);
                  if (p) {
                    downloadBtn.href = `/dashboardAdmin/downloadRekapKriteria?periodeId=${p.id}`;
                    downloadBtn.classList.remove('opacity-50', 'pointer-events-none');
                    downloadBtn.innerText = 'Download Rekap';
                  } else {
                    downloadBtn.href = "#";
                    downloadBtn.classList.add('opacity-50', 'pointer-events-none');
                    downloadBtn.innerText = 'Periode Tidak Ditemukan';
                  }
                }

                tahunSelect.addEventListener('change', () => updateSemesters(false));
                semesterSelect.addEventListener('change', applyFilter);

                // Init: update semesters without reloading
                updateSemesters(true); 
              </script>

              <!-- TABLE -->
              <div class="bg-white rounded-lg shadow overflow-hidden">
                <div class="bg-red-700 text-white font-bold p-4 text-center md:text-left text-lg">
                  Rekap Penilaian - <%= periodeAktif ? periodeAktif.namaPeriode : 'Tahun ?' %>
                </div>

                <div class="overflow-x-auto">
                  <table class="w-full border-collapse text-center text-sm min-w-[1000px]">
                    <thead class="bg-gray-100 border-b">
                      <tr>
                        <th class="p-3 font-semibold text-gray-600">No</th>
                        <th
                          class="p-3 font-semibold text-gray-600 text-left sticky left-0 bg-gray-100 z-10 shadow-sm md:shadow-none">
                          Nama Unit</th>
                        <th class="p-3 font-semibold text-gray-600">Tim</th>
                        <% criteriaList.forEach(function(c) { %>
                          <th class="p-3 font-semibold text-gray-600" title="<%= c.namaKriteria %>">
                            <%= c.kunciKriteria %>
                          </th>
                          <% }); %>
                      </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100">
                      <% if (rekapList.length===0) { %>
                        <tr>
                          <td colspan="<%= 3 + criteriaList.length %>" class="p-12 text-center">
                            <% if (hasUnapprovedData) { %>
                              <div class="text-yellow-600 flex flex-col items-center">
                                <svg class="w-12 h-12 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <p class="font-bold">Beberapa data penilaian sedang menunggu persetujuan Ketua Tim.</p>
                                <p class="text-sm">Silakan hubungi Ketua Tim untuk melakukan Approval.</p>
                              </div>
                              <% } else { %>
                                <p class="text-gray-500 italic">Belum ada penilaian yang masuk (APPROVED).</p>
                                <% } %>
                          </td>
                        </tr>
                        <% } %>

                          <% rekapList.forEach(function(row, idx) { %>
                            <tr class="hover:bg-gray-50 transition">
                              <td class="p-3 text-gray-600">
                                <%= idx + 1 %>
                              </td>
                              <td
                                class="p-3 text-left font-medium text-gray-800 sticky left-0 bg-white z-10 shadow-sm md:shadow-none">
                                <%= row.kantor.nama %>
                              </td>
                              <td class="p-3 text-gray-600">
                                <%= row.timNama %>
                              </td>

                              <% criteriaList.forEach(function(c) { %>
                                <td class="p-3 text-gray-600">
                                  <%= row.values[c.kunciKriteria] %>
                                </td>
                                <% }); %>
                            </tr>
                            <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <div class="mt-auto">
              <%- include('../partials/footer') %>
            </div>
          </main>
      </div>
  </div>
</body>

</html>