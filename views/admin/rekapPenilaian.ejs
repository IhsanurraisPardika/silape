<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <title>Rekap Penilaian 5P</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/images/sp.png" type="image/sp.png">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 antialiased">

  <div class="flex h-screen overflow-hidden">

    <!-- SIDEBAR -->
    <%- include('../partials/sidebarAdmin') %>

      <!-- MAIN -->
      <div class="flex-1 flex flex-col overflow-hidden">
        <%- include('../partials/headerAdmin') %>

          <main class="flex-1 overflow-auto bg-gray-50">
            <div class="p-4 md:p-8">

              <!-- TITLE -->
              <h1 class="text-2xl md:text-3xl font-bold mb-4 md:mb-6 text-gray-800">Rekap Penilaian 5P</h1>

              <!-- TAB -->
              <div class="flex flex-col sm:flex-row gap-3 mb-6">
                <a href="/dashboardAdmin/rekapKantorAdmin"
                  class="text-center px-5 py-2 bg-white rounded shadow hover:bg-gray-50 transition">
                  Rekap Kantor
                </a>

                <a href="/dashboardAdmin/rekapPenilaianAdmin"
                  class="text-center px-5 py-2 bg-red-600 text-white rounded shadow transition">
                  Rekap Penilaian
                </a>

                <a href="/dashboardAdmin/rekapKriteriaAdmin"
                  class="text-center px-5 py-2 bg-white rounded shadow hover:bg-gray-50 transition">
                  Rekap Kriteria
                </a>
              </div>

              <!-- FILTER -->
              <div class="bg-white p-5 rounded shadow mb-6 flex flex-col md:flex-row gap-4 items-end">
                <div class="w-full md:w-auto">
                  <label class="block font-medium mb-1 text-sm text-gray-600">Tahun</label>
                  <select id="tahunFilter"
                    class="w-full border rounded-lg px-3 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-red-500">
                    <% [...new Set(periodes.map(p=> p.tahun))].forEach(tahun => { %>
                      <option value="<%= tahun %>" <%=periodeAktif && periodeAktif.tahun===tahun ? 'selected' : '' %>>
                        <%= tahun %>
                      </option>
                      <% }) %>
                  </select>
                </div>

                <div class="w-full md:w-auto">
                  <label class="block font-medium mb-1 text-sm text-gray-600">Semester</label>
                  <select id="semesterFilter"
                    class="w-full border rounded-lg px-3 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-red-500">
                    <option value="1" <%=periodeAktif && periodeAktif.semester===1 ? 'selected' : '' %>>1</option>
                    <option value="2" <%=periodeAktif && periodeAktif.semester===2 ? 'selected' : '' %>>2</option>
                  </select>
                </div>

                <div class="w-full md:w-auto md:ml-auto">
                  <a id="downloadBtn" href="/dashboardAdmin/downloadRekapPenilaian"
                    class="block text-center w-full md:w-auto bg-green-600 text-white px-5 py-2 rounded-lg hover:bg-green-700 transition shadow">
                    <i class="fas fa-file-excel mr-2"></i> Unduh Rekap
                  </a>
                </div>
              </div>

              <div id="periodesData" data-periodes="<%= JSON.stringify(periodes) %>" class="hidden"></div>

              <script>
                // ... script content remains mostly same, just styling updates ...
                const periodes = JSON.parse(document.getElementById('periodesData').dataset.periodes);
                const tahunSelect = document.getElementById('tahunFilter');
                const semesterSelect = document.getElementById('semesterFilter');
                const downloadBtn = document.getElementById('downloadBtn');

                // Get current periodeId from URL
                const urlParams = new URLSearchParams(window.location.search);
                const currentPeriodeId = urlParams.get('periodeId');

                function updateSemesters(isInit = false) {
                  const selectedTahun = parseInt(tahunSelect.value);
                  const validSemesters = periodes
                    .filter(p => p.tahun === selectedTahun)
                    .map(p => p.semester)
                    .sort((a, b) => a - b);

                  // Keep current semester if it exists in new list
                  const currentVal = semesterSelect.value;
                  semesterSelect.innerHTML = '';

                  validSemesters.forEach(sms => {
                    const opt = document.createElement('option');
                    opt.value = sms;
                    opt.innerText = sms;
                    if (sms.toString() === currentVal) opt.selected = true;
                    semesterSelect.appendChild(opt);
                  });

                  if (!isInit) {
                    applyFilter();
                  } else {
                    updateDownloadLink();
                  }
                }

                function applyFilter() {
                  const thn = parseInt(tahunSelect.value);
                  const sms = parseInt(semesterSelect.value);
                  const p = periodes.find(item => item.tahun === thn && item.semester === sms);

                  if (p && p.id.toString() !== currentPeriodeId) {
                    window.location.href = `/dashboardAdmin/rekapPenilaianAdmin?periodeId=${p.id}`;
                  } else {
                    updateDownloadLink();
                  }
                }

                function updateDownloadLink() {
                  const thn = parseInt(tahunSelect.value);
                  const sms = parseInt(semesterSelect.value);
                  const p = periodes.find(item => item.tahun === thn && item.semester === sms);
                  if (p) {
                    downloadBtn.href = `/dashboardAdmin/downloadRekapPenilaian?periodeId=${p.id}`;
                    downloadBtn.classList.remove('opacity-50', 'pointer-events-none');
                    downloadBtn.innerText = 'Download Rekap';
                  } else {
                    downloadBtn.href = "#";
                    downloadBtn.classList.add('opacity-50', 'pointer-events-none');
                    downloadBtn.innerText = 'Periode Tidak Ditemukan';
                  }
                }

                tahunSelect.addEventListener('change', () => updateSemesters(false));
                semesterSelect.addEventListener('change', applyFilter);

                // Init: update semesters without reloading
                updateSemesters(true); 
              </script>

              <!-- TABLE & CARDS Container -->
              <div class="bg-white rounded-lg shadow overflow-hidden">
                <div class="bg-red-700 text-white font-bold p-4 text-center md:text-left">
                  Rekap Penilaian - <%= periodeAktif ? periodeAktif.namaPeriode : '' %>
                </div>

                <!-- DESKTOP TABLE -->
                <div class="hidden md:block overflow-x-auto">
                  <table class="w-full text-center text-sm">
                    <thead class="bg-gray-100 border-b">
                      <tr>
                        <th class="p-3 font-semibold text-gray-600">Waktu</th>
                        <th class="p-3 font-semibold text-gray-600 text-left">Nama Unit</th>
                        <th class="p-3 font-semibold text-gray-600">Tim</th>
                        <th class="p-3 font-semibold text-gray-600">P1</th>
                        <th class="p-3 font-semibold text-gray-600">P2</th>
                        <th class="p-3 font-semibold text-gray-600">P3</th>
                        <th class="p-3 font-semibold text-gray-600">P4</th>
                        <th class="p-3 font-semibold text-gray-600">P5</th>
                        <th class="p-3 font-semibold text-gray-600">Nilai Akhir</th>
                        <th class="p-3 font-semibold text-gray-600">Predikat</th>
                        <th class="p-3 font-semibold text-gray-600">Catatan</th>
                      </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100">
                      <% if (rekapList.length===0) { %>
                        <tr>
                          <td colspan="11" class="p-12 text-center">
                            <% if (hasUnapprovedData) { %>
                              <div class="text-yellow-600 flex flex-col items-center">
                                <svg class="w-12 h-12 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <p class="font-bold">Beberapa data penilaian sedang menunggu persetujuan Ketua Tim
                                  (Status: SUBMIT).</p>
                                <p class="text-sm">Data belum muncul di sini karena belum APPROVE.</p>
                              </div>
                              <% } else { %>
                                <p class="text-gray-500 italic">Belum ada penilaian yang disetujui (APPROVED).</p>
                                <% } %>
                          </td>
                        </tr>
                        <% } %>

                          <% rekapList.forEach((row, idx)=> { %>
                            <tr class="hover:bg-gray-50 transition">
                              <td class="p-3 text-gray-600">
                                <%= row.waktu %>
                              </td>
                              <td class="p-3 text-left font-medium text-gray-800">
                                <%= row.kantor.nama %>
                              </td>
                              <td class="p-3 text-gray-600">
                                <%= row.timNama %>
                              </td>
                              <td class="p-3 text-gray-600">
                                <%= row.scores.P1 %>
                              </td>
                              <td class="p-3 text-gray-600">
                                <%= row.scores.P2 %>
                              </td>
                              <td class="p-3 text-gray-600">
                                <%= row.scores.P3 %>
                              </td>
                              <td class="p-3 text-gray-600">
                                <%= row.scores.P4 %>
                              </td>
                              <td class="p-3 text-gray-600">
                                <%= row.scores.P5 %>
                              </td>
                              <td class="p-3 font-bold text-gray-800">
                                <%= row.nilaiAkhir %>
                              </td>
                              <td class="p-3">
                                <span
                                  class="<%= row.predikat.color %> px-3 py-1 rounded-full text-xs font-bold text-white shadow-sm">
                                  <%= row.predikat.label %>
                                </span>
                              </td>
                              <td class="p-3">
                                <button type="button" data-idx="<%= idx %>"
                                  onclick="openRekomendasi(this.getAttribute('data-idx'))"
                                  class="text-blue-600 hover:text-blue-800 hover:underline font-medium text-xs">
                                  Lihat
                                </button>
                              </td>
                            </tr>
                            <% }); %>
                    </tbody>
                  </table>
                </div>

                <!-- MOBILE CARDS -->
                <div class="md:hidden divide-y divide-gray-200">
                  <% if (rekapList.length===0) { %>
                    <div class="p-8 text-center text-gray-500 italic">Belum ada penilaian yang disubmit.</div>
                    <% } else { %>
                      <% rekapList.forEach((row, idx)=> { %>
                        <div class="p-4 bg-white hover:bg-gray-50 transition space-y-3">
                          <!-- Header Card -->
                          <div class="flex justify-between items-start">
                            <div>
                              <div class="font-bold text-gray-800 text-lg mb-1">
                                <%= row.kantor.nama %>
                              </div>
                              <div class="text-xs text-gray-500 flex items-center gap-2">
                                <span class="bg-gray-100 px-2 py-0.5 rounded">
                                  <%= row.timNama %>
                                </span>
                                <span>
                                  <%= row.waktu %>
                                </span>
                              </div>
                            </div>
                            <span
                              class="<%= row.predikat.color %> px-3 py-1 rounded-full text-xs font-bold text-white shadow-sm">
                              <%= row.predikat.label %>
                            </span>
                          </div>

                          <!-- Scores Grid -->
                          <div class="grid grid-cols-5 gap-2 text-center bg-gray-50 p-2 rounded-lg">
                            <div>
                              <div class="text-[10px] text-gray-400 uppercase font-bold">P1</div>
                              <div class="font-medium text-gray-700 text-sm">
                                <%= row.scores.P1 %>
                              </div>
                            </div>
                            <div>
                              <div class="text-[10px] text-gray-400 uppercase font-bold">P2</div>
                              <div class="font-medium text-gray-700 text-sm">
                                <%= row.scores.P2 %>
                              </div>
                            </div>
                            <div>
                              <div class="text-[10px] text-gray-400 uppercase font-bold">P3</div>
                              <div class="font-medium text-gray-700 text-sm">
                                <%= row.scores.P3 %>
                              </div>
                            </div>
                            <div>
                              <div class="text-[10px] text-gray-400 uppercase font-bold">P4</div>
                              <div class="font-medium text-gray-700 text-sm">
                                <%= row.scores.P4 %>
                              </div>
                            </div>
                            <div>
                              <div class="text-[10px] text-gray-400 uppercase font-bold">P5</div>
                              <div class="font-medium text-gray-700 text-sm">
                                <%= row.scores.P5 %>
                              </div>
                            </div>
                          </div>

                          <!-- Footer Card -->
                          <div class="flex justify-between items-center pt-2 border-t border-gray-100">
                            <div class="text-sm">
                              <span class="text-gray-500 mr-2">Nilai Akhir:</span>
                              <span class="font-bold text-gray-800 text-lg">
                                <%= row.nilaiAkhir %>
                              </span>
                            </div>
                            <button type="button" data-idx="<%= idx %>"
                              onclick="openRekomendasi(this.getAttribute('data-idx'))"
                              class="text-blue-600 hover:text-blue-800 font-medium text-sm flex items-center gap-1">
                              Lihat Catatan <span class="text-lg">›</span>
                            </button>
                          </div>
                        </div>
                        <% }); %>
                          <% } %>
                </div>
              </div>
            </div>
          </main>

          <%- include('../partials/footer') %>

      </div>
  </div>

  <!-- MODAL REKOMENDASI -->
  <div id="modalRekomendasi" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50">
    <div class="w-[650px] bg-gray-200 rounded-xl overflow-hidden shadow-2xl section-fade-in">

      <!-- Header -->
      <div class="bg-red-700 text-white px-5 py-4 flex justify-between items-center font-semibold">
        <span id="modalTitle">REKOMENDASI</span>
        <button onclick="closeRekomendasi()" class="text-2xl leading-none hover:text-gray-300">
          ×
        </button>
      </div>

      <!-- BODY MODAL -->
      <div class="p-5 space-y-4 text-sm max-h-[60vh] overflow-y-auto" id="modalBody">
        <!-- Dynamic Content -->
      </div>
    </div>
  </div>

  <!-- Data Injection for Modal -->
  <div id="rekapDataSource" data-value="<%= JSON.stringify(rekapList) %>" class="hidden"></div>
  <script>
    const rekapData = JSON.parse(document.getElementById('rekapDataSource').getAttribute('data-value'));

    function openRekomendasi(idx) {
      const data = rekapData[idx];
      if (!data) return;

      const modal = document.getElementById('modalRekomendasi');
      const modalBody = document.getElementById('modalBody');
      const modalTitle = document.getElementById('modalTitle');

      modalTitle.innerText = `REKOMENDASI - ${data.kantor.nama.toUpperCase()}`;

      if (data.rekomendasi && data.rekomendasi.length > 0) {
        modalBody.innerHTML = data.rekomendasi.map(rek => `
              <div class="mb-4 last:mb-0">
                <p class="font-bold mb-1 text-gray-700"><i class="fas fa-user-edit mr-2"></i>${rek.penilai}</p>
                <div class="bg-white rounded-lg border border-gray-300 p-4 text-gray-700 shadow-sm leading-relaxed">
                  ${rek.text}
                </div>
              </div>
            `).join('');
      } else {
        modalBody.innerHTML = `
                <div class="text-center py-8 text-gray-500 italic flex flex-col items-center">
                    <i class="fas fa-clipboard-check text-4xl mb-3 text-gray-300"></i>
                    <p>Tidak ada rekomendasi yang diberikan oleh tim penilai.</p>
                </div>
            `;
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeRekomendasi() {
      const modal = document.getElementById('modalRekomendasi');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  </script>

</body>

</html>