<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daftar Penilaian</title>
  <link rel="icon" href="/images/sp.png" type="image/sp.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="antialiased bg-gray-100">

  <div class="flex h-screen overflow-hidden">
    <%- include('partials/sidebar') %>

      <!-- Main Area -->
      <div class="flex-1 flex flex-col bg-gray-50 overflow-hidden">

        <!-- Header (SAMA PERSIS DENGAN HOME) -->
        <%- include('partials/header') %>

          <!-- Content -->
          <main class="flex-1 overflow-auto bg-gray-50">
            <div class="p-4 md:p-8 pb-24">

              <!-- Title -->
              <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 mb-6">
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800">
                  Daftar Penilaian
                </h1>

                <div class="flex items-center gap-2">
                  <span class="text-xs font-semibold text-gray-500">Periode Aktif:</span>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-50 text-red-700 border border-red-100">
                    <%= (typeof activePeriode !== 'undefined' && activePeriode && activePeriode.namaPeriode)
                      ? activePeriode.namaPeriode
                      : '-' %>
                  </span>
                </div>
              </div>

              <!-- Table Card -->
              <div class="bg-white rounded-xl shadow overflow-hidden">

                <!-- Desktop Table Head -->
                <div class="hidden md:grid grid-cols-6 px-6 py-4 font-semibold text-white bg-red-600">
                  <div>Tanggal</div>
                  <div class="text-center">Kantor</div>
                  <div class="text-center">Rata-rata</div>
                  <div class="text-center">Status</div>
                  <div class="text-center">Aksi</div>
                  <div class="text-center">Approval</div>
                </div>

                <!-- Content Body -->
                <% if (data.length===0) { %>
                  <div class="px-6 py-8 text-center text-gray-500 italic">
                    Belum ada riwayat daftar Penilaian
                  </div>
                  <% } else { %>
                    <div class="divide-y divide-gray-100">
                      <% data.forEach(item=> { %>
                        <!-- Desktop Row -->
                        <div class="hidden md:grid grid-cols-6 px-6 py-4 items-center hover:bg-gray-50 transition">
                          <div class="text-sm text-gray-700">
                            <%= item.tanggal %>
                          </div>

                          <div class="text-sm text-gray-700 font-medium">
                            <%- item.kantor %>
                          </div>

                          <div class="font-bold text-green-600 text-center">
                            <%= item.rata %>
                          </div>

                          <div class="text-center">
                            <% const statusText = (item.status === 'Approval') ? 'Approve' : item.status; %>
                            <% if (statusText === 'Selesai') { %>
                              <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-700">
                                <%= statusText %>
                              </span>
                            <% } else if (statusText === 'Approve') { %>
                              <span class="px-3 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-700">
                                <%= statusText %>
                              </span>
                            <% } else if (statusText === 'Process') { %>
                              <span class="px-3 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-700">
                                <%= statusText %>
                              </span>
                            <% } else { %>
                              <span class="px-3 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700">
                                <%= statusText %>
                              </span>
                            <% } %>
                          </div>

                          <div class="text-center">
                            <% if (item.isApproved || item.canEdit === false) { %>
                              <button disabled
                                class="text-gray-400 font-semibold bg-gray-100 px-3 py-1 rounded-lg cursor-not-allowed">
                                <i class="fas fa-lock mr-1"></i> Edit
                              </button>
                            <% } else { %>
                              <a href="<%= item.detailUrl %>"
                                class="inline-block text-blue-600 font-semibold hover:underline bg-blue-50 px-3 py-1 rounded-lg">
                                <i class="fas fa-edit mr-1"></i> Edit
                              </a>
                            <% } %>
                          </div>

                          <div class="text-center">
                            <% if (item.isApproved) { %>
                              <% if (item.buktiUrl) { %>
                                <a href="<%= item.buktiUrl %>"
                                  class="inline-block px-4 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition">
                                  Unduh Bukti
                                </a>
                              <% } else { %>
                                <span class="text-sm text-gray-300 font-bold">-</span>
                              <% } %>
                            <% } else if (item.isSelesai) { %>
                              <% if (isKetua) { %>
                                <button
                                  class="px-4 py-1.5 text-xs font-bold text-white transition bg-green-600 hover:bg-green-700 rounded-lg shadow-sm"
                                  onclick="approvePenilaian('<%= item.kantorId %>', '<%= item.periodeId %>', this)">
                                  Approve
                                </button>
                              <% } else { %>
                                <button disabled
                                  class="px-4 py-1.5 text-xs font-bold text-white bg-gray-300 cursor-not-allowed rounded-lg">
                                  Approve
                                </button>
                              <% } %>
                            <% } else { %>
                              <span class="text-sm text-gray-300 font-bold">-</span>
                            <% } %>
                          </div>
                        </div>

                        <!-- Mobile Card -->
                        <div class="md:hidden p-4 space-y-3 bg-white hover:bg-gray-50 transition">
                          <div class="flex justify-between items-start">
                            <div>
                              <div class="text-xs text-gray-500 mb-1">
                                <%= item.tanggal %>
                              </div>
                              <div class="font-bold text-gray-800"><%- item.kantor %></div>
                            </div>
                            <div class="text-right">
                              <span class="font-bold text-green-600 text-xl block">
                                <%= item.rata %>
                              </span>
                            </div>
                          </div>

                          <div class="flex justify-between items-center py-2 border-t border-b border-gray-50">
                            <div class="text-sm text-gray-600">Status:</div>
                            <div>
                              <% const statusTextMobile = (item.status === 'Approval') ? 'Approve' : item.status; %>
                              <% if (statusTextMobile==='Selesai' ) { %>
                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-700">
                                  <%= statusTextMobile %>
                                </span>
                                <% } else if (statusTextMobile==='Approve' ) { %>
                                  <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-700">
                                    <%= statusTextMobile %>
                                  </span>
                                  <% } else if (statusTextMobile==='Process' ) { %>
                                    <span
                                      class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-700">
                                      <%= statusTextMobile %>
                                    </span>
                                  <% } else { %>
                                    <span
                                      class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700">
                                      <%= statusTextMobile %>
                                    </span>
                                    <% } %>
                            </div>
                          </div>

                          <div class="flex gap-2 pt-1">
                            <a href="<%= item.detailUrl %>"
                              class="flex-1 text-center text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-3 py-2 rounded-lg transition text-sm font-medium">
                              Edit
                            </a>

                            <% if (item.isApproved) { %>
                              <% if (item.buktiUrl) { %>
                                <a href="<%= item.buktiUrl %>"
                                  class="flex-1 text-center px-3 py-2 text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition">
                                  Unduh
                                </a>
                              <% } else { %>
                                <div
                                  class="flex-1 flex items-center justify-center bg-gray-50 text-gray-300 rounded-lg text-sm font-bold">
                                  -
                                </div>
                              <% } %>
                            <% } else if (item.isSelesai) { %>
                              <% if (isKetua) { %>
                                <button
                                  class="flex-1 px-3 py-2 text-sm font-bold text-white transition bg-green-600 hover:bg-green-700 rounded-lg shadow-sm"
                                  onclick="approvePenilaian('<%= item.kantorId %>', '<%= item.periodeId %>', this)">
                                  Approve
                                </button>
                              <% } else { %>
                                <button disabled
                                  class="flex-1 px-3 py-2 text-sm font-bold text-white bg-gray-300 cursor-not-allowed rounded-lg">
                                  Approve
                                </button>
                              <% } %>
                            <% } else { %>
                              <div
                                class="flex-1 flex items-center justify-center bg-gray-50 text-gray-300 rounded-lg text-sm font-bold">
                                -
                              </div>
                            <% } %>
                          </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>


                        <script>
                          async function approvePenilaian(kantorId, periodeId, buttonEl) {
                            const result = await Swal.fire({
                              title: 'Approve Penilaian?',
                              text: 'Tindakan ini akan mengubah status menjadi Approve.',
                              icon: 'question',
                              showCancelButton: true,
                              confirmButtonText: 'Ya, Approve',
                              cancelButtonText: 'Batal',
                              confirmButtonColor: '#16a34a',
                              cancelButtonColor: '#d1d5db'
                            });

                            if (!result.isConfirmed) return;

                            const prevText = buttonEl ? buttonEl.textContent : '';
                            if (buttonEl) {
                              buttonEl.disabled = true;
                              buttonEl.textContent = 'Memproses...';
                              buttonEl.classList.remove('hover:bg-green-700');
                              buttonEl.classList.add('bg-gray-400', 'cursor-not-allowed');
                            }

                            try {
                              const res = await fetch('/daftarPenilaian/approve', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ kantorId, periodeId })
                              });
                              const data = await res.json().catch(() => ({}));

                              if (res.ok && data.success) {
                                await Swal.fire({
                                  icon: 'success',
                                  title: 'Berhasil',
                                  text: 'Penilaian berhasil di-approve.',
                                  confirmButtonColor: '#16a34a'
                                });
                                window.location.reload();
                                return;
                              }

                              await Swal.fire({
                                icon: 'error',
                                title: 'Gagal',
                                text: data.message || 'Approve gagal diproses.',
                                confirmButtonColor: '#dc2626'
                              });
                            } catch (e) {
                              console.error(e);
                              await Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Gagal menghubungi server.',
                                confirmButtonColor: '#dc2626'
                              });
                            } finally {
                              if (buttonEl) {
                                buttonEl.disabled = false;
                                buttonEl.textContent = prevText || 'Approve';
                                buttonEl.classList.remove('bg-gray-400', 'cursor-not-allowed');
                                buttonEl.classList.add('hover:bg-green-700');
                              }
                            }
                          }
                        </script>

              </div>

            </div>
          </main>
      </div>
  </div>

</body>
</html>