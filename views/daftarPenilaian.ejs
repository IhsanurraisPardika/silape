<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daftar Penilaian</title>
  <link rel="icon" href="/images/sp.png" type="image/sp.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="antialiased bg-gray-100">

  <div class="flex h-screen overflow-hidden">
    <%- include('partials/sidebar') %>

      <!-- Main Area -->
      <div class="flex-1 flex flex-col bg-gray-50 overflow-hidden">

        <!-- Header (SAMA PERSIS DENGAN HOME) -->
        <%- include('partials/header') %>

          <!-- Content -->
          <main class="flex-1 overflow-auto bg-gray-50">
            <div class="p-4 md:p-8 pb-24">

              <!-- Title -->
              <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-6">
                Daftar Penilaian
              </h1>

              <!-- Table Card -->
              <div class="bg-white rounded-xl shadow overflow-hidden">

                <!-- Desktop Table Head -->
                <div class="hidden md:grid grid-cols-6 px-6 py-4 font-semibold text-white bg-red-600">
                  <div>Tanggal</div>
                  <div>Kantor</div>
                  <div>Rata-rata</div>
                  <div>Status</div>
                  <div class="text-center">Aksi</div>
                  <div class="text-center">Approve</div>
                </div>

                <!-- Content Body -->
                <% if (data.length===0) { %>
                  <div class="px-6 py-8 text-center text-gray-500 italic">
                    Belum ada riwayat daftar Penilaian
                  </div>
                  <% } else { %>
                    <div class="divide-y divide-gray-100">
                      <% data.forEach(item=> { %>
                        <!-- Desktop Row -->
                        <div class="hidden md:grid grid-cols-6 px-6 py-4 items-center hover:bg-gray-50 transition">
                          <div class="text-sm text-gray-700">
                            <%= item.tanggal %>
                          </div>

                          <div class="text-sm text-gray-700 font-medium">
                            <%- item.kantor %>
                          </div>

                          <div class="font-bold text-green-600 text-lg">
                            <%= item.rata %>
                          </div>

                          <div>
                            <% if (item.status==='Selesai' ) { %>
                              <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-700">
                                <%= item.status %>
                              </span>
                              <% } %>
                      </div>

                      <div>
                        <% if (item.isApproved || item.canEdit === false) { %>
                          <button disabled
                            class="text-gray-400 font-semibold bg-gray-100 px-3 py-1 rounded-lg cursor-not-allowed">
                            <i class="fas fa-lock mr-1"></i> Edit
                          </button>
                        <% } else { %>
                          <a href="<%= item.detailUrl %>"
                            class="text-blue-600 font-semibold hover:underline bg-blue-50 px-3 py-1 rounded-lg">
                            <i class="fas fa-edit mr-1"></i> Edit
                          </a>
                        <% } %>
                      </div>

                      <div>
                        <% if (item.isSelesai) { %>
                          <% if (isKetua) { %>
                            <button
                              class="px-3 py-1 text-sm rounded-lg font-bold text-white transition bg-blue-600 hover:bg-blue-700"
                              onclick="approvePenilaian('<%= item.kantorId %>', '<%= item.periodeId %>', this)">
                              Approve
                            </button>
                            <% } else { %>
                              <button disabled
                                class="px-3 py-1 text-sm rounded-lg font-bold text-white bg-gray-400 cursor-not-allowed">
                                Approve
                              </button>
                              <% } %>
                              <% } else if (item.status==='Approval' ) { %>
                                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-700">
                                  <%= item.status %>
                                </span>
                                <% } else { %>
                                  <span
                                    class="px-3 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-700">
                                    <%= item.status %>
                                  </span>
                                  <% } %>
                          </div>

                          <div class="text-center">
                            <a href="<%= item.detailUrl %>"
                              class="inline-block text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-lg transition text-sm font-medium">
                              <i class="fas fa-edit mr-1"></i> Edit
                            </a>
                          </div>

                          <div class="text-center">
                            <% if (item.isSelesai) { %>
                              <% if (isKetua) { %>
                                <button
                                  class="px-4 py-1.5 text-xs font-bold text-white transition bg-green-600 hover:bg-green-700 rounded-lg shadow-sm"
                                  onclick="approvePenilaian('<%= item.kantorId %>', '<%= item.periodeId %>')">
                                  Approve
                                </button>
                                <% } else { %>
                                  <button disabled
                                    class="px-4 py-1.5 text-xs font-bold text-white bg-gray-300 cursor-not-allowed rounded-lg">
                                    Approve
                                  </button>
                                  <% } %>
                                    <% } else { %>
                                      <span class="text-sm text-gray-300 font-bold">-</span>
                                      <% } %>
                          </div>
                        </div>

                        <!-- Mobile Card -->
                        <div class="md:hidden p-4 space-y-3 bg-white hover:bg-gray-50 transition">
                          <div class="flex justify-between items-start">
                            <div>
                              <div class="text-xs text-gray-500 mb-1">
                                <%= item.tanggal %>
                              </div>
                              <div class="font-bold text-gray-800"><%- item.kantor %></div>
                            </div>
                            <div class="text-right">
                              <span class="font-bold text-green-600 text-xl block">
                                <%= item.rata %>
                              </span>
                            </div>
                          </div>

                          <div class="flex justify-between items-center py-2 border-t border-b border-gray-50">
                            <div class="text-sm text-gray-600">Status:</div>
                            <div>
                              <% if (item.status==='Selesai' ) { %>
                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-700">
                                  <%= item.status %>
                                </span>
                                <% } else if (item.status==='Approval' ) { %>
                                  <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-700">
                                    <%= item.status %>
                                  </span>
                                  <% } else { %>
                                    <span
                                      class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-700">
                                      <%= item.status %>
                                    </span>
                                    <% } %>
                            </div>
                          </div>

                          <div class="flex gap-2 pt-1">
                            <a href="<%= item.detailUrl %>"
                              class="flex-1 text-center text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-3 py-2 rounded-lg transition text-sm font-medium">
                              Edit
                            </a>

                            <% if (item.isSelesai) { %>
                              <% if (isKetua) { %>
                                <button
                                  class="flex-1 px-3 py-2 text-sm font-bold text-white transition bg-green-600 hover:bg-green-700 rounded-lg shadow-sm"
                                  onclick="approvePenilaian('<%= item.kantorId %>', '<%= item.periodeId %>')">
                                  Approve
                                </button>
                                <% } else { %>
                                  <button disabled
                                    class="flex-1 px-3 py-2 text-sm font-bold text-white bg-gray-300 cursor-not-allowed rounded-lg">
                                    Approve
                                  </button>
                                  <% } %>
                                    <% } else { %>
                                      <div
                                        class="flex-1 flex items-center justify-center bg-gray-50 text-gray-300 rounded-lg text-sm font-bold">
                                        -
                                      </div>
                                      <% } %>
                          </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>


                        <!-- Simple script for handling approve -->
                        <script>
                          async function approvePenilaian(kantorId, periodeId, buttonEl) {
                            const result = await Swal.fire({
                              title: 'Approve Penilaian?'
                              , text: 'Tindakan ini akan mengubah status menjadi Approval.'
                              , icon: 'question'
                              , showCancelButton: true
                              , confirmButtonText: 'Ya, Approve'
                              , cancelButtonText: 'Batal'
                              , confirmButtonColor: '#1d4ed8'
                      <!-- Simple script for handling approve -->
                      <script>
                        async function approvePenilaian(kantorId, periodeId) {
                          const result = await Swal.fire({
                            title: 'Approve Penilaian?',
                            text: 'Tindakan ini akan mengubah status menjadi Approval.',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonText: 'Ya, Approve',
                            cancelButtonText: 'Batal',
                            confirmButtonColor: '#16a34a',
                            cancelButtonColor: '#d1d5db'
                          });

                          if (!result.isConfirmed) return;

                          try {
                            const res = await fetch('/daftarPenilaian/approve', {
                              method: 'POST',
                              headers: { 'Content-Type': 'application/json' },
                              body: JSON.stringify({ kantorId, periodeId })
                            });
                            const data = await res.json().catch(() => ({}));

                            if (!result.isConfirmed) return;

                            if (buttonEl) {
                              buttonEl.disabled = true;
                              buttonEl.classList.remove('hover:bg-blue-700');
                              buttonEl.classList.add('bg-gray-400', 'cursor-not-allowed');
                            }

                            try {
                              const res = await fetch('/daftarPenilaian/approve', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ kantorId, periodeId })
                              });
                              const data = await res.json().catch(() => ({}));

                              if (res.ok && data.success) {
                                await Swal.fire({
                                  icon: 'success',
                                  title: 'Berhasil',
                                  text: 'Penilaian berhasil di-approve.',
                                  confirmButtonColor: '#1d4ed8'
                                });
                                window.location.reload();
                              } else {
                                await Swal.fire({
                                  icon: 'error',
                                  title: 'Gagal',
                                  text: data.message || 'Approval gagal diproses.',
                                  confirmButtonColor: '#1d4ed8'
                                });
                                if (buttonEl) {
                                  buttonEl.disabled = false;
                                  buttonEl.classList.add('hover:bg-blue-700');
                                  buttonEl.classList.remove('bg-gray-400', 'cursor-not-allowed');
                                }
                              }
                            } catch (e) {
                              await Swal.fire({
                                icon: 'error',
                                title: 'Gagal',
                                text: data.message || 'Approval gagal diproses.',
                                confirmButtonColor: '#dc2626'
                              });
                              if (buttonEl) {
                                buttonEl.disabled = false;
                                buttonEl.classList.add('hover:bg-blue-700');
                                buttonEl.classList.remove('bg-gray-400', 'cursor-not-allowed');
                              }
                            }
                          } catch (e) {
                            console.error(e);
                            await Swal.fire({
                              icon: 'error',
                              title: 'Error',
                              text: 'Gagal menghubungi server.',
                              confirmButtonColor: '#dc2626'
                            });
                          }
                        }
                      </script>

              </div>

            </div>
          </main>
      </div>
  </div>

</body>
</html>