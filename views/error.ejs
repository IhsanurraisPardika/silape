<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'Error' %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 flex items-center justify-center min-h-screen px-4">
    <div class="bg-white p-6 md:p-8 rounded-xl shadow-lg text-center max-w-md w-full">
        <h1 class="text-2xl md:text-3xl font-bold text-red-600 mb-4">
            <%= title || 'Error' %>
        </h1>
        <p class="text-gray-600 mb-8 text-sm md:text-base">
            <%= message || 'Something went wrong.' %>
        </p>
        <a href="javascript:history.back()"
            class="inline-block bg-blue-600 text-white px-6 py-2.5 rounded-lg hover:bg-blue-700 transition font-medium shadow-sm">
            Go Back
        </a>
    </div>
</body>

</html>