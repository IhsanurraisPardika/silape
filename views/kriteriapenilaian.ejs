          r21_40: 'Ada standar Pemantapan (P4) tapi belum dilaksanakan.',
          r41_60: 'Ada standar Pemantapan (P4) dan dilaksanakan dengan cukup baik.',
          r61_80: 'Ada standar Pemantapan (P4) dan dilaksanakan dengan baik & konsisten.',
          r81_100: 'Ada standar Pemantapan (P4) secara detail dan dilaksanakan dengan baik & konsisten.'
        }
      ],
      'P5': [
        {
          kriteria: 'Sikap Kerja & Kedisiplinan',
          r0_20: 'Sebagian besar personil organisasi/area kerja belum mempunyai sikap kerja/kebiasaan positif dan disiplin.',
