    function switchTab(pKey) {
      const body = document.getElementById('kriteria-body');
      const btns = document.querySelectorAll('.tab-btn');

      btns.forEach(btn => {
        btn.classList.remove('tab-active', 'text-red-600');
        btn.classList.add('text-gray-500');
      });

      const activeBtn = document.getElementById('btn-' + pKey);
      activeBtn.classList.add('tab-active', 'text-red-600');
      activeBtn.classList.remove('text-gray-500');

      body.innerHTML = '';
      
      const items = kriteriaData[pKey];
      if (items && items.length > 0) {
        items.forEach((item, index) => {
          const row = `
            <tr class="hover:bg-gray-50 transition-colors group align-top">
              <td class="px-4 py-4 text-center font-bold text-gray-500 group-hover:text-red-600 sticky left-0 bg-white group-hover:bg-gray-50 border-r border-gray-100">
                ${index + 1}
              </td>
              <td class="px-4 py-4 font-bold text-gray-800 sticky left-12 bg-white group-hover:bg-gray-50 border-r border-gray-100 shadow-[4px_0_5px_-2px_rgba(0,0,0,0.05)]">
                ${item.kriteria}
              </td>
              <td class="px-4 py-4 border-r border-gray-100 bg-red-50/30 text-gray-600 group-hover:bg-red-50/50">
                ${item.r0_20}
              </td>
              <td class="px-4 py-4 border-r border-gray-100 bg-orange-50/30 text-gray-600 group-hover:bg-orange-50/50">
                ${item.r21_40}
              </td>
              <td class="px-4 py-4 border-r border-gray-100 bg-yellow-50/30 text-gray-600 group-hover:bg-yellow-50/50">
                ${item.r41_60}
              </td>
              <td class="px-4 py-4 border-r border-gray-100 bg-blue-50/30 text-gray-600 group-hover:bg-blue-50/50">
                ${item.r61_80}
              </td>
              <td class="px-4 py-4 bg-green-50/30 text-gray-800 font-medium group-hover:bg-green-50/50 border-l-2 border-green-100">
                ${item.r81_100}
              </td>
            </tr>
          `;
          body.innerHTML += row;
        });
      }
    }

    window.onload = () => switchTab('P1');
  </script>
</body>

</html>