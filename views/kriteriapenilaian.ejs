<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kriteria Penilaian 5P</title>
  <link rel="icon" href="/images/sp.png" type="image/sp.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .tab-active {
      border-bottom: 4px solid #dc2626;
      color: #dc2626;
      font-weight: 700;
    }

    /* Kustomisasi Scrollbar untuk tabel panjang */
    .custom-scrollbar::-webkit-scrollbar {
      height: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f1f1;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>

<body class="antialiased bg-gray-100 font-sans">
  <div class="flex min-h-screen">
    <%- include('partials/sidebar') %>

      <div class="flex-1 flex flex-col transition-all duration-300">

        <%- include('partials/header') %>

          <main class="flex-1 p-4 md:p-8 pb-24">

            <div class="max-w-[95rem] mx-auto">
              <div class="mb-6 md:mb-8">
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 tracking-tight">Kriteria
                  Penilaian 5P Kantor</h1>
                <p class="text-sm md:text-base text-gray-600 mt-1">Standar operasional penilaian lengkap (0-100)
                  kebersihan dan tata kelola lingkungan kerja.</p>
              </div>

              <div
                class="bg-white rounded-t-xl shadow-sm border-b flex overflow-x-auto sticky top-[73px] z-20 no-scrollbar">
                <button onclick="switchTab('P1')" id="btn-P1"
                  class="tab-btn flex-shrink-0 px-6 py-4 md:px-8 md:py-5 font-bold text-sm md:text-base text-gray-500 hover:text-red-600 transition-all border-b-4 border-transparent tab-active">
                  P1: PEMILAHAN
                </button>
                <button onclick="switchTab('P2')" id="btn-P2"
                  class="tab-btn flex-shrink-0 px-6 py-4 md:px-8 md:py-5 font-bold text-sm md:text-base text-gray-500 hover:text-red-600 transition-all border-b-4 border-transparent">
                  P2: PENATAAN
                </button>
                <button onclick="switchTab('P3')" id="btn-P3"
                  class="tab-btn flex-shrink-0 px-6 py-4 md:px-8 md:py-5 font-bold text-sm md:text-base text-gray-500 hover:text-red-600 transition-all border-b-4 border-transparent">
                  P3: PEMBERSIHAN
                </button>
                <button onclick="switchTab('P4')" id="btn-P4"
                  class="tab-btn flex-shrink-0 px-6 py-4 md:px-8 md:py-5 font-bold text-sm md:text-base text-gray-500 hover:text-red-600 transition-all border-b-4 border-transparent">
                  P4: PEMANTAPAN
                </button>
                <button onclick="switchTab('P5')" id="btn-P5"
                  class="tab-btn flex-shrink-0 px-6 py-4 md:px-8 md:py-5 font-bold text-sm md:text-base text-gray-500 hover:text-red-600 transition-all border-b-4 border-transparent">
                  P5: PEMBIASAAN
                </button>
              </div>

              <div class="bg-white rounded-b-xl shadow-xl p-4 md:p-6 mb-12 border-t-0 overflow-hidden">
                <div class="overflow-x-auto custom-scrollbar pb-4">
                  <table class="w-full text-left border-collapse min-w-[1200px]">
                    <thead>
                      <tr class="bg-gray-50 text-gray-700 uppercase text-xs tracking-wider border-b border-gray-200">
                        <th class="px-4 py-4 font-bold w-12 text-center sticky left-0 bg-gray-50 z-10 border-r">No</th>
                        <th class="px-4 py-4 font-bold w-64 sticky left-12 bg-gray-50 z-10 border-r shadow-sm">Kriteria Penilaian</th>
                        <th class="px-4 py-4 font-bold text-center w-1/5 bg-red-50 text-red-700 border-r border-red-100">0 - 20<br><span class="text-[10px] font-normal text-red-500 capitalize">(Sangat Kurang)</span></th>
                        <th class="px-4 py-4 font-bold text-center w-1/5 bg-orange-50 text-orange-700 border-r border-orange-100">21 - 40<br><span class="text-[10px] font-normal text-orange-500 capitalize">(Kurang)</span></th>
                        <th class="px-4 py-4 font-bold text-center w-1/5 bg-yellow-50 text-yellow-700 border-r border-yellow-100">41 - 60<br><span class="text-[10px] font-normal text-yellow-600 capitalize">(Cukup)</span></th>
                        <th class="px-4 py-4 font-bold text-center w-1/5 bg-blue-50 text-blue-700 border-r border-blue-100">61 - 80<br><span class="text-[10px] font-normal text-blue-500 capitalize">(Baik)</span></th>
                        <th class="px-4 py-4 font-bold text-center w-1/5 bg-green-50 text-green-700">81 - 100<br><span class="text-[10px] font-normal text-green-600 capitalize">(Sangat Baik)</span></th>
                      </tr>
                    </thead>
                    <tbody id="kriteria-body" class="divide-y divide-gray-100 text-sm text-gray-700">
                      </tbody>
                  </table>
                </div>
              </div>

            </div>
          </main>
      </div>
  </div>

  <script>
