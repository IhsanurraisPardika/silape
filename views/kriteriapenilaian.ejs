<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kriteria Penilaian 5P</title>
    <link rel="icon" href="/images/sp.png" type="image/sp.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .tab-active {
            border-bottom: 4px solid #dc2626;
            color: #dc2626;
        }

        .bg-red-sp {
            background-color: #dc2626;
        }
    </style>
</head>

<body class="antialiased bg-gray-100">
    <div class="flex min-h-screen">
        <%- include('partials/sidebar') %>

            <div class="flex-1 flex flex-col transition-all duration-300">

                <%- include('partials/header') %>

                    <main class="flex-1 p-4 md:p-8 pb-24">

                        <div class="max-w-6xl mx-auto">
                            <div class="mb-6 md:mb-8">
                                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 tracking-tight">Kriteria
                                    Penilaian
                                    5P Kantor</h1>
                                <p class="text-sm md:text-base text-gray-600 mt-1">Standar operasional penilaian
                                    kebersihan
                                    dan tata kelola lingkungan kerja sesuai form penilaian.</p>
                            </div>

                            <!-- Responsive Tab Container -->
                            <div
                                class="bg-white rounded-t-2xl shadow-sm border-b flex overflow-x-auto sticky top-[73px] z-20 no-scrollbar">
                                <button onclick="switchTab('P1')" id="btn-P1"
                                    class="tab-btn flex-shrink-0 px-6 py-4 md:px-8 md:py-5 font-bold text-sm md:text-base text-gray-400 hover:text-red-600 transition-all border-b-4 border-transparent tab-active">P1:
                                    PEMILAHAN</button>
                                <button onclick="switchTab('P2')" id="btn-P2"
                                    class="tab-btn flex-shrink-0 px-6 py-4 md:px-8 md:py-5 font-bold text-sm md:text-base text-gray-400 hover:text-red-600 transition-all border-b-4 border-transparent">P2:
                                    PENATAAN</button>
                                <button onclick="switchTab('P3')" id="btn-P3"
                                    class="tab-btn flex-shrink-0 px-6 py-4 md:px-8 md:py-5 font-bold text-sm md:text-base text-gray-400 hover:text-red-600 transition-all border-b-4 border-transparent">P3:
                                    PEMBERSIHAN</button>
                                <button onclick="switchTab('P4')" id="btn-P4"
                                    class="tab-btn flex-shrink-0 px-6 py-4 md:px-8 md:py-5 font-bold text-sm md:text-base text-gray-400 hover:text-red-600 transition-all border-b-4 border-transparent">P4:
                                    PEMANTAPAN</button>
                                <button onclick="switchTab('P5')" id="btn-P5"
                                    class="tab-btn flex-shrink-0 px-6 py-4 md:px-8 md:py-5 font-bold text-sm md:text-base text-gray-400 hover:text-red-600 transition-all border-b-4 border-transparent">P5:
                                    PEMBIASAAN</button>
                            </div>

                            <div class="bg-white rounded-b-2xl shadow-xl p-4 md:p-6 mb-12 border-t-0">

                                <!-- Desktop Header (Hidden on Mobile) -->
                                <div
                                    class="hidden md:grid grid-cols-12 gap-4 bg-gray-50 text-gray-700 uppercase text-xs tracking-widest font-bold px-4 py-3 border-b mb-2 rounded-lg">
                                    <div class="col-span-1 text-center">No</div>
                                    <div class="col-span-3">Objek Penilaian / Area</div>
                                    <div class="col-span-7">Kriteria & Standar Penilaian</div>
                                    <div class="col-span-1 text-center">Skor</div>
                                </div>

                                <!-- Content Body -->
                                <div id="kriteria-body" class="space-y-4 md:space-y-0">
                                    <!-- Content will be injected here via JS -->
                                </div>
                            </div>
                        </div>
                    </main>
            </div>
    </div>

    <script>
        // Data diupdate sesuai standar Audit 5P/5R Perkantoran Profesional
        const kriteriaData = {
            'P1': [
                { area: 'Meja Kerja & Laci', detail: 'Tidak ada dokumen/barang yang tidak diperlukan (sampah, kertas bekas, ATK rusak) di atas maupun di dalam meja.', skor: 20 },
                { area: 'Lemari Arsip / Rak', detail: 'Hanya menyimpan dokumen/barang yang masih relevan dengan pekerjaan. Dokumen kadaluarsa dipisahkan/dimusnahkan.', skor: 20 },
                { area: 'Area Bawah Meja', detail: 'Bebas dari penumpukan barang yang tidak terpakai (kardus kosong, sepatu bekas, tas tidak terpakai).', skor: 20 },
                { area: 'Lantai & Dinding', detail: 'Tidak ada barang/peralatan rusak yang diletakkan sembarangan di sudut ruangan atau bersandar di dinding.', skor: 20 },
                { area: 'Peralatan Elektronik', detail: 'Memisahkan kabel atau perangkat elektronik yang rusak/tidak terpakai dari area kerja aktif.', skor: 20 }
            ],
            'P2': [
                { area: 'Tata Letak Dokumen', detail: 'Dokumen tersusun rapi dalam ordner/map, dikelompokkan sesuai jenis, dan mudah ditemukan (kurang dari 30 detik).', skor: 20 },
                { area: 'Identitas & Labeling', detail: 'Semua ordner, laci, lemari, dan saklar lampu memiliki label identitas yang jelas, lurus, dan mudah dibaca.', skor: 20 },
                { area: 'Stationary (ATK)', detail: 'ATK tersimpan di tempat khusus (organizer) dan tidak berserakan di atas meja setelah digunakan.', skor: 20 },
                { area: 'Manajemen Kabel', detail: 'Kabel PC, telepon, dan listrik terikat rapi (cable ties/spiral), tidak semrawut, dan tidak membahayakan.', skor: 20 },
                { area: 'Penyimpanan Tas/Helm', detail: 'Tas, helm, dan barang pribadi karyawan ditempatkan pada tempat khusus/loker yang disediakan.', skor: 20 }
            ],
            'P3': [
                { area: 'Lantai & Sudut Ruang', detail: 'Lantai bersih, kering, tidak berdebu, dan sudut ruangan bebas dari sarang laba-laba.', skor: 20 },
                { area: 'Perangkat Kerja (PC/Telp)', detail: 'Layar monitor, keyboard, CPU, dan telepon bersih dari debu dan noda.', skor: 20 },
                { area: 'Kaca & Jendela', detail: 'Kaca jendela, partisi ruangan, dan kusen bersih serta tembus pandang (tidak buram).', skor: 20 },
                { area: 'Tempat Sampah', detail: 'Tempat sampah tersedia, tidak penuh (overload), dan kondisi fisik tempat sampah bersih.', skor: 20 },
                { area: 'Plafon & Lampu', detail: 'Langit-langit bersih dari kotoran/bocor, dan rumah lampu bebas dari debu.', skor: 20 }
            ],
            'P4': [
                { area: 'Visual Management', detail: 'Terdapat rambu/tanda standar (jalur evakuasi, dilarang merokok, jagalah kebersihan) yang terawat baik.', skor: 25 },
                { area: 'Standarisasi Layout', detail: 'Penataan meja, kursi, dan lemari seragam sesuai standar layout yang ditetapkan perusahaan.', skor: 25 },
                { area: 'Kontrol Visual', detail: 'Terdapat garis pembatas (line marking) atau shadow board untuk penempatan barang inventaris kantor.', skor: 25 },
                { area: 'Sirkulasi Udara', detail: 'Suhu ruangan terjaga (AC berfungsi baik) dan pencahayaan memadai sesuai standar kesehatan kerja.', skor: 25 }
            ],
            'P5': [
                { area: 'Disiplin 5 Menit', detail: 'Karyawan terbiasa melakukan "5 Menit Resik" sebelum mulai dan sesudah selesai bekerja.', skor: 25 },
                { area: 'Kepatuhan Atribut', detail: 'Karyawan menggunakan ID Card dan seragam sesuai ketentuan perusahaan saat berada di area kerja.', skor: 25 },
                { area: 'Jadwal Piket', detail: 'Terdapat jadwal piket kebersihan yang tertempel dan dilaksanakan secara konsisten.', skor: 25 },
                { area: 'Budaya K3', detail: 'Karyawan peduli terhadap aspek keselamatan (tidak menghalangi APAR, tidak membiarkan kabel terkelupas).', skor: 25 }
            ]
        };

        function switchTab(pKey) {
            const body = document.getElementById('kriteria-body');
            const btns = document.querySelectorAll('.tab-btn');

            // Handle active state button
            btns.forEach(btn => {
                btn.classList.remove('tab-active', 'text-red-600');
                btn.classList.add('text-gray-400');
            });

            const activeBtn = document.getElementById('btn-' + pKey);
            activeBtn.classList.add('tab-active', 'text-red-600');
            activeBtn.classList.remove('text-gray-400');

            // Render content
            body.innerHTML = '';
            kriteriaData[pKey].forEach((item, index) => {
                // Responsive Grid/Card Item
                const row = `
                    <div class="hover:bg-red-50/50 transition-colors group border-b md:border-b-0 border-gray-100 last:border-0 pb-4 md:pb-0">
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-4 px-2 md:px-4 py-2 md:py-3 items-start">
                            
                            <!-- No (Hidden on Mobile usually, or shown small) -->
                            <div class="md:col-span-1 md:text-center flex items-center gap-2 md:block">
                                <span class="md:hidden text-xs font-bold text-gray-400 uppercase">No.</span>
                                <span class="text-sm font-bold text-gray-500 group-hover:text-red-600">${index + 1}</span>
                            </div>

                            <!-- Area -->
                            <div class="md:col-span-3">
                                <span class="md:hidden block text-xs font-bold text-gray-400 uppercase mb-1">Area / Objek:</span>
                                <span class="font-bold text-gray-800 text-sm md:text-base">${item.area}</span>
                            </div>

                            <!-- Detail -->
                            <div class="md:col-span-7">
                                <span class="md:hidden block text-xs font-bold text-gray-400 uppercase mb-1 mt-2">Kriteria:</span>
                                <span class="text-sm leading-relaxed text-gray-600">${item.detail}</span>
                            </div>

                            <!-- Skor -->
                            <div class="md:col-span-1 md:text-center mt-2 md:mt-0">
                                <div class="inline-flex md:flex items-center gap-2 md:justify-center bg-red-50 md:bg-transparent px-3 py-1 md:p-0 rounded-full md:rounded-none">
                                    <span class="md:hidden text-xs font-bold text-red-600 uppercase">Max Skor:</span>
                                    <span class="font-bold text-red-600 text-sm">${item.skor}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                body.innerHTML += row;
            });
        }

        // Initialize first tab
        window.onload = () => switchTab('P1');
    </script>
</body>

</html>