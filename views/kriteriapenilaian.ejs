          r61_80: 'Sudah ada standar Pemilahan (P1) dan sudah dilaksanakan dengan baik & konsisten.',
          r81_100: 'Sudah ada standar Pemilahan (P1) secara detail dan sudah dilaksanakan dengan baik & konsisten.'
        }
      ],
      'P2': [
