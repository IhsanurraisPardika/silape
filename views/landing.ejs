<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" href="/images/sp.png" type="image/sp.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .bg-factory {
            background-image: url('/images/semenpadang2.jpg');
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
        }

        /* Smooth scroll behavior */
        html {
            scroll-behavior: smooth;
        }
    </style>
</head>

<body class="antialiased bg-gray-50 text-gray-800 font-sans">

    <!-- Navbar / Custom Header for Landing Page -->
    <nav class="bg-white/90 backdrop-blur-md shadow-sm fixed w-full z-50 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo -->
                <div class="flex items-center gap-3">
                    <img src="/images/sp.png" alt="Logo SP" class="h-10 w-auto">
                    <a href="/" class="text-2xl font-extrabold text-red-600 tracking-wide">SILAPE</a>
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden md:flex items-center gap-8">
                    <a href="#about"
                        class="text-sm font-medium text-gray-600 hover:text-red-600 transition-colors">Tentang Kami</a>
                    <a href="#assessment"
                        class="text-sm font-medium text-gray-600 hover:text-red-600 transition-colors">Penilaian 5P</a>

                    <a href="/login"
                        class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm font-bold rounded-full shadow-lg hover:shadow-red-500/30 transition-all transform hover:-translate-y-0.5">
                        Login
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-btn" class="text-gray-600 hover:text-red-600 focus:outline-none">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100">
            <div class="px-4 pt-2 pb-6 space-y-2">
                <a href="#about"
                    class="block px-3 py-2 text-base font-medium text-gray-700 hover:text-red-600 hover:bg-gray-50 rounded-md">Tentang
                    Kami</a>
                <a href="#assessment"
                    class="block px-3 py-2 text-base font-medium text-gray-700 hover:text-red-600 hover:bg-gray-50 rounded-md">Penilaian
                    5P</a>
                <div class="pt-4 mt-2 border-t border-gray-100">
                    <a href="/login"
                        class="block w-full text-center px-4 py-3 bg-red-600 text-white font-bold rounded-lg shadow-md hover:bg-red-700 transition">
                        Login
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <!-- HERO SECTION -->
        <section class="relative bg-factory h-screen min-h-[600px] flex items-center justify-center pt-20">
            <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/70 z-0"></div>

            <div class="relative z-10 text-center px-4 max-w-5xl mx-auto animate-fade-in-up">
                <div class="mb-8 inline-block animate-bounce-slow">
                    <img src="/images/sp.png" alt="Logo SP" class="h-24 md:h-32 mx-auto drop-shadow-2xl">
                </div>

                <h1
                    class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white mb-6 tracking-tight leading-tight drop-shadow-lg">
                    Selamat Datang di <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-red-400">SILAPE</span>
                </h1>

                <p
                    class="text-lg md:text-2xl text-gray-200 mb-10 max-w-3xl mx-auto font-light leading-relaxed drop-shadow-md">
                    Sistem Informasi Penilaian 5P<br>
                    <span class="font-semibold text-white">PT Semen Padang</span>
                </p>

                <div class="flex flex-col sm:flex-row gap-5 justify-center">
                    <a href="/login"
                        class="px-8 py-4 bg-red-600 hover:bg-red-700 text-white text-lg font-bold rounded-full transition-all shadow-xl hover:shadow-red-500/40 transform hover:-translate-y-1 flex items-center justify-center gap-2 min-w-[180px]">
                        Masuk Sekarang
                    </a>
                    <a href="#about"
                        class="px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-md text-white text-lg font-semibold rounded-full border border-white/30 transition-all flex items-center justify-center min-w-[180px]">
                        Pelajari Lebih Lanjut
                    </a>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce text-white/50">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </div>
        </section>

        <!-- ABOUT TPM OFFICER SECTION -->
        <section id="about" class="py-20 md:py-32 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20">
                    <!-- Image/Illustration -->
                    <div class="w-full md:w-1/2 order-2 md:order-1">
                        <div
                            class="relative rounded-3xl overflow-hidden shadow-2xl transform hover:scale-[1.01] transition-transform duration-500 group">
                            <img src="/images/FotoTPM.jpeg" alt="Office Environment"
                                class="w-full h-auto object-cover aspect-[4/3] group-hover:scale-105 transition-transform duration-700">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent">
                            </div>
                            <div class="absolute bottom-8 left-8 text-white">
                                <div class="w-12 h-1 bg-red-600 mb-4 rounded-full"></div>
                                <p class="font-bold text-2xl tracking-wide">Unit TPM Officer</p>
                                <p class="text-white/80 mt-1 font-light">Menjaga Standar Keunggulan Operasional</p>
                            </div>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="w-full md:w-1/2 order-1 md:order-2">
                        <div
                            class="inline-flex items-center gap-2 px-4 py-2 bg-red-100/50 text-red-700 font-bold text-sm rounded-full mb-6 border border-red-100">
                            <span class="w-2 h-2 rounded-full bg-red-600"></span>
                            Tentang Kami
                        </div>
                        <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-8 leading-tight">
                            Unit TPM Officer<br>
                            <span class="text-red-600">PT Semen Padang</span>
                        </h2>
                        <p class="text-gray-600 text-lg leading-relaxed mb-6">
                            Unit <span class="font-semibold text-gray-900">Total Productive Maintenance (TPM)
                                Officer</span> memegang peranan strategis dalam menciptakan ekosistem kerja yang tidak
                            hanya produktif, tetapi juga aman, bersih, dan efisien melalui penerapan budaya 5P.
                        </p>
                        <p class="text-gray-600 text-lg leading-relaxed mb-10">
                            Fokus utama kami adalah melakukan penilaian objektif, memberikan pendampingan intensif,
                            serta mendorong semangat perbaikan berkelanjutan (<span class="italic">Kaizen</span>) di
                            setiap lini operasional perusahaan.
                        </p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl border border-gray-100">
                                <span
                                    class="flex-shrink-0 w-8 h-8 rounded-full bg-red-100 text-red-600 flex items-center justify-center">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </span>
                                <span class="font-medium text-gray-800">Audit Berkala</span>
                            </div>
                            <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl border border-gray-100">
                                <span
                                    class="flex-shrink-0 w-8 h-8 rounded-full bg-red-100 text-red-600 flex items-center justify-center">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z">
                                        </path>
                                    </svg>
                                </span>
                                <span class="font-medium text-gray-800">Standarisasi Area</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5P ASSESSMENT SECTION -->
        <section id="assessment" class="py-20 md:py-32 bg-gray-50 relative overflow-hidden">
            <!-- Decorative Background -->
            <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
                <div
                    class="absolute -top-[20%] -right-[10%] w-[600px] h-[600px] bg-red-100/50 rounded-full blur-3xl mix-blend-multiply opacity-60">
                </div>
                <div
                    class="absolute bottom-[0%] left-[0%] w-[500px] h-[500px] bg-gray-200/50 rounded-full blur-3xl mix-blend-multiply opacity-60">
                </div>
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center max-w-4xl mx-auto mb-20">
                    <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6">Tentang Penilaian <span
                            class="text-red-600">5P</span></h2>
                    <p class="text-gray-600 text-xl leading-relaxed">
                        Fondasi utama kami dalam menciptakan lingkungan kerja yang berkualitas, aman, dan nyaman melalui
                        lima pilar keunggulan.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-8">
                    <!-- P1 -->
                    <div
                        class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border-t-[6px] border-red-500 group relative overflow-hidden">
                        <div
                            class="absolute top-0 right-0 w-24 h-24 bg-red-50 rounded-bl-full -mr-12 -mt-12 transition-all group-hover:scale-150 group-hover:bg-red-100">
                        </div>
                        <div class="relative z-10">
                            <div
                                class="w-14 h-14 bg-red-100 rounded-2xl flex items-center justify-center text-red-600 font-bold text-2xl mb-6 shadow-sm group-hover:scale-110 transition-transform duration-300">
                                P1
                            </div>
                            <h3 class="text-2xl font-bold text-gray-900 mb-3">Pemilahan</h3>
                            <p class="text-gray-500 leading-relaxed text-sm">
                                Memisahkan barang yang diperlukan dari yang tidak, menyingkirkan yang tidak perlu agar
                                area kerja lebih efisien.
                            </p>
                        </div>
                    </div>

                    <!-- P2 -->
                    <div
                        class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border-t-[6px] border-orange-500 group relative overflow-hidden">
                        <div
                            class="absolute top-0 right-0 w-24 h-24 bg-orange-50 rounded-bl-full -mr-12 -mt-12 transition-all group-hover:scale-150 group-hover:bg-orange-100">
                        </div>
                        <div class="relative z-10">
                            <div
                                class="w-14 h-14 bg-orange-100 rounded-2xl flex items-center justify-center text-orange-600 font-bold text-2xl mb-6 shadow-sm group-hover:scale-110 transition-transform duration-300">
                                P2
                            </div>
                            <h3 class="text-2xl font-bold text-gray-900 mb-3">Penataan</h3>
                            <p class="text-gray-500 leading-relaxed text-sm">
                                Menata barang agar mudah ditemukan dan diambil. Setiap barang memiliki tempatnya
                                sendiri.
                            </p>
                        </div>
                    </div>

                    <!-- P3 -->
                    <div
                        class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border-t-[6px] border-yellow-500 group relative overflow-hidden">
                        <div
                            class="absolute top-0 right-0 w-24 h-24 bg-yellow-50 rounded-bl-full -mr-12 -mt-12 transition-all group-hover:scale-150 group-hover:bg-yellow-100">
                        </div>
                        <div class="relative z-10">
                            <div
                                class="w-14 h-14 bg-yellow-100 rounded-2xl flex items-center justify-center text-yellow-600 font-bold text-2xl mb-6 shadow-sm group-hover:scale-110 transition-transform duration-300">
                                P3
                            </div>
                            <h3 class="text-2xl font-bold text-gray-900 mb-3">Pembersihan</h3>
                            <p class="text-gray-500 leading-relaxed text-sm">
                                Membersihkan lingkungan kerja secara rutin, sekaligus memeriksa kondisi peralatan
                                (inspeksi).
                            </p>
                        </div>
                    </div>

                    <!-- P4 -->
                    <div
                        class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border-t-[6px] border-blue-500 group relative overflow-hidden">
                        <div
                            class="absolute top-0 right-0 w-24 h-24 bg-blue-50 rounded-bl-full -mr-12 -mt-12 transition-all group-hover:scale-150 group-hover:bg-blue-100">
                        </div>
                        <div class="relative z-10">
                            <div
                                class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center text-blue-600 font-bold text-2xl mb-6 shadow-sm group-hover:scale-110 transition-transform duration-300">
                                P4
                            </div>
                            <h3 class="text-2xl font-bold text-gray-900 mb-3">Pemantapan</h3>
                            <p class="text-gray-500 leading-relaxed text-sm">
                                Memelihara standar tinggi P1-P3 secara konsisten dan terus-menerus.
                            </p>
                        </div>
                    </div>

                    <!-- P5 -->
                    <div
                        class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border-t-[6px] border-green-500 group relative overflow-hidden">
                        <div
                            class="absolute top-0 right-0 w-24 h-24 bg-green-50 rounded-bl-full -mr-12 -mt-12 transition-all group-hover:scale-150 group-hover:bg-green-100">
                        </div>
                        <div class="relative z-10">
                            <div
                                class="w-14 h-14 bg-green-100 rounded-2xl flex items-center justify-center text-green-600 font-bold text-2xl mb-6 shadow-sm group-hover:scale-110 transition-transform duration-300">
                                P5
                            </div>
                            <h3 class="text-2xl font-bold text-gray-900 mb-3">Pembiasaan</h3>
                            <p class="text-gray-500 leading-relaxed text-sm">
                                Membangun kedisiplinan diri dan menjadikan 5P sebagai budaya kerja sehari-hari.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="bg-gray-900 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-center text-center md:text-left gap-8">
                <div>
                    <div class="flex items-center justify-center md:justify-start gap-3 mb-4">
                        <img src="/images/sp.png" alt="Logo SP" class="h-10 w-auto brightness-200 grayscale">
                        <span class="text-2xl font-bold tracking-wider">SILAPE</span>
                    </div>
                    <p class="text-gray-400 max-w-xs mx-auto md:mx-0">
                        Sistem Informasi Penilaian 5P PT Semen Padang. Mendorong keunggulan operasional melalui
                        budaya 5P.
                    </p>
                </div>

                <div class="flex flex-wrap justify-center gap-8 text-sm font-medium text-gray-300">
                    <a href="#about" class="hover:text-white transition-colors">Tentang Kami</a>
                    <a href="#assessment" class="hover:text-white transition-colors">Penilaian 5P</a>
                </div>
            </div>

            <div class="mt-12 border-t border-gray-800 pt-8 text-center text-sm text-gray-500">
                <p>&copy; <%= new Date().getFullYear() %> PT Semen Padang. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Script for mobile menu -->
    <script>
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Close mobile menu when clicking a link
        document.querySelectorAll('#mobile-menu a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Navbar blur effect on scroll
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 10) {
                nav.classList.add('shadow-md');
            } else {
                nav.classList.remove('shadow-md');
            }
        });
    </script>
</body>

</html>